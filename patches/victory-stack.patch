+        release(r);
+        // The overlay opens: the pad is still connected, at rest; no key is held.
+        let events = hub.sample_with(true);
+        hub.deliver(events);
+        let r = current(hub, GAMEPAD_KIND, 0).unwrap();
+        assert_eq!(pad(r), PadState::default());
+        release(r);
