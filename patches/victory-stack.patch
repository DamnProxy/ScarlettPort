+    }
+}
+
+fn output(name: &str) -> Option<Output> {
+    OUTPUTS
+        .iter()
+        .find(|(n, _)| n.eq_ignore_ascii_case(name.trim()))
+        .map(|(_, o)| *o)
+}
+
+/// Keys and what each does, for one situation (on foot, in a vehicle).
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Layout(BTreeMap<u8, Vec<Output>>);
+
+impl Layout {
+    fn outputs(&self, vk: u8) -> &[Output] {
+        self.0.get(&vk).map_or(&[], Vec::as_slice)
+    }
+
+    /// Binds `key` to `outputs` (none: unbinds it).
+    fn bind(&mut self, key: &str, outputs: &[&str]) -> Result<(), String> {
+        let vk = key_code(key).ok_or_else(|| format!("unknown key `{key}`"))?;
+        let outs = outputs
+            .iter()
+            .filter(|o| !o.trim().is_empty())
+            .map(|o| output(o).ok_or_else(|| format!("unknown pad output `{o}` for key `{key}`")))
+            .collect::<Result<Vec<_>, _>>()?;
+        if outs.is_empty() {
+            self.0.remove(&vk);
+        } else {
+            self.0.insert(vk, outs);
+        }
+        Ok(())
+    }
+
+    /// The keys that do `out`, by key code.
+    pub fn keys_of(&self, out: Output) -> Vec<u8> {
+        self.0
+            .iter()
+            .filter(|(_, outs)| outs.contains(&out))
+            .map(|(vk, _)| *vk)
+            .collect()
+    }
+
+    /// What `vk` does.
+    pub fn outputs_of(&self, vk: u8) -> &[Output] {
+        self.outputs(vk)
+    }
+
+    /// Makes `new` do `out` (and nothing else: what it did is taken from
+    /// it) and, when `old` is given, takes `out` from that key. `new` of
+    /// `None` only unbinds `old`. Returns what `new` did before.
+    pub fn rebind(&mut self, out: Output, old: Option<u8>, new: Option<u8>) -> Vec<Output> {
+        if let Some(old) = old
+            && Some(old) != new
+        {
+            let rest: Vec<Output> = self.outputs(old).iter().copied().filter(|o| *o != out).collect();
+            if rest.is_empty() {
+                self.0.remove(&old);
+            } else {
+                self.0.insert(old, rest);
+            }
+        }
+        let Some(new) = new else { return Vec::new() };
+        let before: Vec<Output> = self.outputs(new).iter().copied().filter(|o| *o != out).collect();
+        self.0.insert(new, vec![out]);
+        before
+    }
+
+    /// Key map lines (`Key=Out,Out`) for the keys that differ from `base`;
+    /// a key `base` binds and this does not is written with nothing after
+    /// the `=`.
+    fn keymap_lines(&self, base: &Layout) -> Vec<String> {
+        let mut lines = Vec::new();
+        let keys: std::collections::BTreeSet<u8> =
+            self.0.keys().chain(base.0.keys()).copied().collect();
+        for vk in keys {
+            let (mine, theirs) = (self.outputs(vk), base.outputs(vk));
+            if mine == theirs {
+                continue;
+            }
+            let outs: Vec<&str> = mine.iter().map(|o| o.name()).collect();
+            lines.push(format!("{}={}", key_name(vk), outs.join(",")));
+        }
+        lines
+    }
+
+    fn of(table: &[(&str, &[&str])]) -> Layout {
+        let mut layout = Layout::default();
+        for (key, outs) in table {
+            layout.bind(key, outs).expect("default bindings use known names");
+        }
+        layout
+    }
+}
+
+/// The keys both layouts share: the default PC layout (docs/input.md).
+/// Shift sprints (A), Space is X, E and F are Y, Q and R the bumpers, Ctrl
+/// clicks the left stick; Enter is A and Esc or Backspace B in menus. Alt
+/// frees the mouse. The wheel is the d-pad's up and down.
+const COMMON: &[(&str, &[&str])] = &[
+    ("A", &["LeftLeft"]),
+    ("D", &["LeftRight"]),
+    ("LShift", &["A"]),
+    ("RShift", &["A"]),
+    ("Space", &["X"]),
+    ("E", &["Y"]),
+    ("F", &["Y"]),
+    ("Q", &["LB"]),
+    ("R", &["RB"]),
+    ("LCtrl", &["LS"]),
+    ("RCtrl", &["LS"]),
+    ("C", &["RS"]),
+    ("Tab", &["View"]),
+    ("P", &["Menu"]),
+    ("Z", &["Walk"]),
+    ("G", &["ToggleVehicle"]),
+    ("LAlt", &["ReleaseCursor"]),
+    ("RAlt", &["ReleaseCursor"]),
+    ("Up", &["DpadUp"]),
+    ("Down", &["DpadDown"]),
+    ("Left", &["DpadLeft"]),
+    ("Right", &["DpadRight"]),
+    ("WheelUp", &["DpadUp"]),
+    ("WheelDown", &["DpadDown"]),
+    ("MouseLeft", &["RT"]),
+    ("MouseRight", &["LT"]),
+    ("MouseMiddle", &["RS"]),
+    ("Enter", &["A"]),
+    ("Backspace", &["B"]),
+    ("Esc", &["B"]),
+];
+
+/// On foot: W/S walk.
+const ON_FOOT: &[(&str, &[&str])] = &[("W", &["LeftUp"]), ("S", &["LeftDown"])];
+
+/// In a vehicle (G switches): W/S are throttle and brake on the triggers.
+const VEHICLE: &[(&str, &[&str])] = &[("W", &["RT"]), ("S", &["LT"])];
+
+fn default_layout(own: &[(&str, &[&str])]) -> Layout {
+    let mut layout = Layout::of(COMMON);
+    for (key, outs) in own {
+        layout.bind(key, outs).expect("default bindings use known names");
+    }
+    layout
+}
+#[derive(Clone, Debug, PartialEq)]
+pub struct Settings {
+    /// Off: the old stand-in pad (README's table) and nothing else.
