+    const DRAW: &str = r#"
+#define RS "DescriptorTable(SRV(t0))"
+Texture2D<float4> image : register(t0);
+[RootSignature(RS)]
+float4 corner(uint i : SV_VertexID) : SV_Position {
+    float2 p = float2((i << 1) & 2, i & 2);
