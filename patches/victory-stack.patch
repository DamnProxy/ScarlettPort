+        let held = [t(1, RT, SRV), t(2, UAV, SRV), t(1, SRV, COPY_DEST)];
+        let c = coalesce(&held);
+        assert_eq!(c.keep, vec![(1, None), (2, Some(RT))]);
+        assert_eq!(c.folded, 1);
