+        // (a switch set to nothing reads as unset in the translator, so it keys alike)
+        assert_eq!(k(b"x", 1, None), k(b"x", 1, Some("")));
+    }
+
+    #[test]
+    fn the_translator_of_this_build_is_named_by_a_fingerprint_not_the_executable() {
