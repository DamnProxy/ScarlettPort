+    #[test]
+    fn ranges_join_and_touch_only_where_they_share_bytes() {
+        let mut r = Ranges::new();
+        r.add([(40, 50), (10, 20), (20, 25), (45, 60), (7, 7)]);
+        assert_eq!(r.as_slice(), &[(10, 25), (40, 60)]);
+        for (from, to, hit) in [
+            (0, 10, false),
+            (0, 11, true),
+            (24, 25, true),
