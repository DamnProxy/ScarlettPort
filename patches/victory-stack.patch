+/// record of each hash (the archive holds duplicates with the same code).
+pub fn index<R: std::io::Read + std::io::Seek>(file: &mut R) -> std::io::Result<Vec<([u8; 16], Place)>> {
+    let mut seen = std::collections::HashSet::new();
+    let mut out = Vec::new();
