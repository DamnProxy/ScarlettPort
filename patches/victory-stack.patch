+        let z3 = m.bin(b, Bin::URem, x, one);
+        let z = m.bin(b, Bin::Or, z1, z2);
+        let z = m.bin(b, Bin::Or, z, z3);
+        // Chained add/sub: ((x + 4) - 2) + 6 == x + 8, then - 8 == x.
+        let six = m.i32(6);
