+            b: pre,
+            writes,
+            ..
+        } = kit();
+        let i32t = m.int(32);
+        let (head, latch, exit) = (m.new_block(), m.new_block(), m.new_block());
+        let (zero, one, four) = (m.i32(0), m.i32(1), m.i32(4));
+        m.terminate(pre, Term::Br(head));
+        let iv = m.phi(head, i32t);
+        m.terminate(head, Term::Br(latch));
