+    ".#.../..#../...#./...#./...#./..#../.#.../.....",
+    "...../..#../#.#.#/.###./#.#.#/..#../...../.....",
+    "...../..#../..#../#####/..#../..#../...../.....",
+    "...../...../...../...../...../..##./..#../.#...",
+    "...../...../...../#####/...../...../...../.....",
+    "...../...../...../...../...../.##../.##../.....",
+    "....#/....#/...#./..#../.#.../#..../#..../.....",
+    // 0 - 9
+    ".###./#...#/#..##/#.#.#/##..#/#...#/.###./.....",
+    "..#../.##../..#../..#../..#../..#../.###./.....",
+    ".###./#...#/....#/...#./..#../.#.../#####/.....",
+    "#####/...#./..#../...#./....#/#...#/.###./.....",
+    "...#./..##./.#.#./#..#./#####/...#./...#./.....",
+    "#####/#..../####./....#/....#/#...#/.###./.....",
+    "..##./.#.../#..../####./#...#/#...#/.###./.....",
+    "#####/....#/...#./..#../.#.../.#.../.#.../.....",
+    ".###./#...#/#...#/.###./#...#/#...#/.###./.....",
+    ".###./#...#/#...#/.####/....#/...#./.##../.....",
+    // : ; < = > ? @
+    "...../.##../.##../...../.##../.##../...../.....",
+    "...../.##../.##../...../.##../..#../.#.../.....",
+    "...#./..#../.#.../#..../.#.../..#../...#./.....",
+    "...../...../#####/...../#####/...../...../.....",
+    ".#.../..#../...#./....#/...#./..#../.#.../.....",
+    ".###./#...#/....#/...#./..#../...../..#../.....",
+    ".###./#...#/#.###/#.#.#/#.###/#..../.###./.....",
+    // A - Z
+    ".###./#...#/#...#/#####/#...#/#...#/#...#/.....",
+    "####./#...#/#...#/####./#...#/#...#/####./.....",
+    ".###./#...#/#..../#..../#..../#...#/.###./.....",
