+    fn ds_common(sticks: [u8; 4], l2: u8, r2: u8, b: [u8; 3]) -> Vec<u8> {
+        let mut c = sticks.to_vec();
+        c.extend([l2, r2, 0x42]); // counter
+        c.extend(b);
+        c.push(0); // b3
