+        assert_eq!(p.buttons & X, X, "Y is jump now");
+        release(r);
+    }
+
+    #[test]
+    fn keyboard_and_mouse_drive_the_stand_in_pad_without_a_host_pad() {
+        let (hub, host) = fake_kbm();
+        {
+            let mut h = host.lock().unwrap();
