+    }
+    // v_ldexp_f32 v0, v1, v2 (VOP3 0x362)
+    // Exact on every host, denormals included: the lowering rounds in integers.
+    check_op(
+        &vop3(0x362, 0, vgpr(1), vgpr(2), 0),
+        &inputs,
+        true,
+        "v_ldexp_f32",
+        |i| ldexp_reference(i[0], i[1] as i32),
+    );
+}
