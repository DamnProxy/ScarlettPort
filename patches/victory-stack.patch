+        at += 4 + stride.checked_mul(resources)?;
+    }
+    let strings = u32_at(part, at).ok()? as usize;
+    at += 4 + strings;
+    let indices = u32_at(part, at).ok()? as usize;
+    at += 4 + 4 * indices;
+    let mut out: PsvModes = Default::default();
+    if ins + outs + prims == 0 {
