+            let got = [out[0][0], out[1][0], out[2][0]];
+            assert_eq!(got, want, "{label}: title index {title:#x}");
+        }
+        ran += 1;
+    }
+    assert!(ran > 0, "neither hardware nor WARP SM 6.6 device available");
+}
