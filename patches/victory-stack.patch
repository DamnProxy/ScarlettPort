+/// them is logged with its pipelines (`HostList::budget`).
+pub(crate) fn guard_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_INDIRECT_GUARD").is_some_and(|v| v == "1"))
+}
