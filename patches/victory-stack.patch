@@ -0,0 +1,250 @@
+//! `VICTORY_READFIX=1` (off by default; with the relay and
+//! `VICTORY_SYNC_PRECISE=1` or `VICTORY_RELAY=2`): a refresh of a host copy
+//! that overlaps what another copy's flights in the air may write is served
+//! on the card instead of waiting for those flights to land.
+//!
+//! The wait it replaces (`WHY_READ`, "title memory read ... another copy"):
+//! a submission refreshes `[from, to)` of copy Y from title memory, and a
+//! flight in the air declared shader writes over some of those bytes on
+//! another copy X (an alias: a 4 MiB window over a title buffer, two views
+//! of one buffer). Title memory there is not what the card will hold until
+//! X's flight has landed and been copied back, so the submission waited for
+//! that whole landing - and the ray-tracing builder declares every copy it
+//! numbered written on every dispatch (`memory.rs`), so the declared ranges
+//! cover most of what the frame's other draws read.
+//!
+//! What landing would give Y there is X's bytes after its flight: the copy
+//! back puts into title memory the bytes the card changed, and leaves the
+//! rest as title memory had them, which is what X took when its flight
+//! went, as long as the title wrote none of them since. So when
+//!
+//! - every byte of the overlap is declared written by one other copy only
+//!   (no read-back, no bottom-of-pipe write, not Y itself),
+//! - X took those pages whole and the title has not written them since,
+//! - Y is a plain copy (not in the card's own memory, not title memory in
+//!   place) and this submission's shaders do not write it there,
+//!
+//! the refresh goes on for the rest, and X's bytes are copied into Y on the
+//! card after X's flight and before this submission's lists: on one queue,
+//! in order, exactly where the console's single memory would have them.
+//! Anything else waits as before. Platform-neutral planning; the host side
+//! is in `host.rs`.
+
+/// Why a refresh was not served on the card (the frame line's counts).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Refuse {
+    /// A flight's bottom-of-pipe write lies in the range.
+    Immed = 0,
+    /// A texture read-back of a flight lands in the range.
+    ReadBack = 1,
+    /// Two copies' flights write the same bytes.
+    TwoWriters = 2,
+    /// Y's own flights write the same bytes as another copy's.
+    OwnWrites = 3,
+    /// Y is in the card's memory or title memory in place.
+    Kind = 4,
+    /// The source copy did not take the pages whole, or the title wrote
+    /// them since.
+    TitleWrote = 5,
+    /// This submission's shaders write Y there.
+    Declared = 6,
+    /// An earlier redirect into Y there is still in the air and this one
+    /// does not cover it.
+    Pending = 7,
+    /// The source copy is not known among the flights.
+    NoSource = 8,
+}
+
+pub(crate) const REFUSALS: usize = 9;
+
+/// Bytes `[from, to)` of title memory, for copy `owner` (an identity: the
+/// `Shadow` pointer).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Piece {
+    pub owner: usize,
+    pub from: usize,
+    pub to: usize,
+}
+
+/// The pieces of `[from, to)` refreshed for copy `copy` that other copies'
+/// flights write (`by_copy`: `(owner, from, to)` joined per owner, `0` for
+/// read-backs; `immed`: bottom-of-pipe writes, joined), each to be copied
+/// from its owner on the card; or why that cannot be done. Empty if
+/// nothing of another copy's lies there.
+pub(crate) fn plan_refresh(
+    copy: usize,
+    from: usize,
+    to: usize,
+    by_copy: &[(usize, usize, usize)],
+    immed: &[(usize, usize)],
+) -> Result<Vec<Piece>, Refuse> {
+    if from >= to {
+        return Ok(Vec::new());
+    }
+    if immed.iter().any(|&(a, b)| a < to && b > from) {
+        return Err(Refuse::Immed);
+    }
+    let hits: Vec<(usize, usize, usize)> = by_copy
+        .iter()
+        .filter(|&&(_, a, b)| a < to && b > from)
+        .map(|&(o, a, b)| (o, a.max(from), b.min(to)))
+        .collect();
+    let mut pieces: Vec<Piece> = Vec::new();
+    for &(owner, a, b) in &hits {
+        if owner == copy {
+            continue;
+        }
+        if owner == 0 {
+            return Err(Refuse::ReadBack);
+        }
+        pieces.push(Piece { owner, from: a, to: b });
+    }
+    // One writer per byte: another owner's (or Y's own) range over a piece
+    // makes what landing gives depend on the order of their copy-backs.
+    for p in &pieces {
+        for &(owner, a, b) in &hits {
+            if owner != p.owner && a < p.to && b > p.from {
+                return Err(if owner == copy { Refuse::OwnWrites } else { Refuse::TwoWriters });
+            }
+        }
+    }
+    pieces.sort_unstable_by_key(|p| (p.from, p.owner));
+    Ok(pieces)
+}
+
+/// Whether `[from, to)` is covered by `pieces` (sorted by `from`, not
+/// overlapping).
+pub(crate) fn covered(pieces: &[Piece], from: usize, to: usize) -> bool {
+    let mut at = from;
+    for p in pieces {
+        if p.to <= at {
+            continue;
+        }
+        if p.from > at {
+            return false;
+        }
+        at = p.to;
+        if at >= to {
+            return true;
+        }
+    }
+    at >= to
+}
+
+/// Whether a copy that took pages `[first, last]` (write-watch pages)
+/// still holds title memory there: each page taken whole once
+/// (`copied[page - base] != 0`) and not written since (`written`: last
+/// writes by page, any order).
+pub(crate) fn took_current(copied: &[u64], base: usize, first: usize, last: usize, written: &[(usize, u64)]) -> bool {
+    (first..=last).all(|page| {
+        let Some(&at) = page.checked_sub(base).and_then(|i| copied.get(i)) else {
+            return false;
+        };
+        at != 0 && !written.iter().any(|&(p, w)| p == page && w > at)
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const Y: usize = 0x100;
+    const X: usize = 0x200;
+    const Z: usize = 0x300;
+
+    #[test]
+    fn nothing_of_another_copy_needs_nothing() {
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &[(Y, 0x1000, 0x2000), (X, 0x3000, 0x4000)], &[]), Ok(vec![]));
+        assert_eq!(plan_refresh(Y, 0x1000, 0x1000, &[(X, 0, 0x9000)], &[]), Ok(vec![]));
+    }
+
+    #[test]
+    fn another_copys_writes_are_cut_to_the_refresh() {
+        let by_copy = [(X, 0x0800, 0x1400), (X, 0x1800, 0x5000)];
+        assert_eq!(
+            plan_refresh(Y, 0x1000, 0x2000, &by_copy, &[]),
+            Ok(vec![Piece { owner: X, from: 0x1000, to: 0x1400 }, Piece { owner: X, from: 0x1800, to: 0x2000 }])
+        );
+    }
+
+    #[test]
+    fn two_writers_of_one_byte_wait() {
+        let by_copy = [(X, 0x1000, 0x1800), (Z, 0x1700, 0x2000)];
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &by_copy, &[]), Err(Refuse::TwoWriters));
+        // Side by side is fine.
+        let by_copy = [(X, 0x1000, 0x1800), (Z, 0x1800, 0x2000)];
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &by_copy, &[]).map(|p| p.len()), Ok(2));
+    }
+
+    #[test]
+    fn own_writes_under_anothers_wait() {
+        let by_copy = [(Y, 0x1000, 0x1100), (X, 0x1000, 0x2000)];
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &by_copy, &[]), Err(Refuse::OwnWrites));
+        // Own writes elsewhere in the range do not matter.
+        let by_copy = [(Y, 0x1000, 0x1100), (X, 0x1800, 0x2000)];
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &by_copy, &[]).map(|p| p.len()), Ok(1));
+    }
+
+    #[test]
+    fn read_backs_and_bottom_of_pipe_writes_wait() {
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &[(0, 0x1f00, 0x2100)], &[]), Err(Refuse::ReadBack));
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &[], &[(0x1ff8, 0x2000)]), Err(Refuse::Immed));
+        // Outside the range they do not.
+        assert_eq!(plan_refresh(Y, 0x1000, 0x2000, &[(0, 0x2000, 0x2100)], &[(0x0ff8, 0x1000)]), Ok(vec![]));
+    }
+
+    #[test]
+    fn coverage() {
+        let p = [Piece { owner: X, from: 0x10, to: 0x20 }, Piece { owner: Z, from: 0x20, to: 0x30 }];
+        assert!(covered(&p, 0x10, 0x30));
+        assert!(covered(&p, 0x18, 0x28));
+        assert!(!covered(&p, 0x08, 0x18));
+        assert!(!covered(&p, 0x28, 0x38));
+        assert!(!covered(&[], 0x10, 0x11));
+        let gap = [Piece { owner: X, from: 0x10, to: 0x18 }, Piece { owner: X, from: 0x19, to: 0x30 }];
+        assert!(!covered(&gap, 0x10, 0x30));
+    }
+
+    #[test]
+    fn a_page_counts_only_if_taken_whole_and_not_written_since() {
+        // Pages 10..=12 of a copy starting at page 10.
+        let copied = [5, 7, 0];
+        assert!(took_current(&copied, 10, 10, 11, &[(10, 5), (11, 3)]));
+        assert!(!took_current(&copied, 10, 10, 11, &[(11, 8)]));
+        // Never taken whole.
+        assert!(!took_current(&copied, 10, 12, 12, &[]));
+        // Outside the copy.
+        assert!(!took_current(&copied, 10, 9, 10, &[]));
+        assert!(!took_current(&copied, 10, 13, 13, &[]));
+    }
+
+    /// The exactness argument on bytes: what landing then refreshing gives
+    /// Y equals the refresh now plus X's card bytes copied over the piece,
+    /// when the title did not write the piece since X took it.
+    #[test]
+    fn serving_on_the_card_gives_what_landing_gives() {
+        // Title memory, 16 bytes; X declared writes over [4, 12).
+        let title: Vec<u8> = (0..16).collect();
+        let mut x_card = title.clone(); // X took it all when its flight went
+        for b in &mut x_card[6..9] {
+            *b = 0xEE; // what X's shaders wrote
+        }
+        // Landing: the bytes the card changed go to title memory; Y then
+        // refreshes all of it.
+        let mut landed = title.clone();
+        for i in 4..12 {
+            if x_card[i] != title[i] {
+                landed[i] = x_card[i];
+            }
+        }
+        let y_after_wait = landed.clone();
+        // Served on the card: Y refreshed from title memory now, then X's
+        // card bytes over the piece.
+        let pieces = plan_refresh(Y, 0, 16, &[(X, 4, 12)], &[]).unwrap();
+        let mut y_now = title.clone();
+        for p in pieces {
+            y_now[p.from..p.to].copy_from_slice(&x_card[p.from..p.to]);
+        }
+        assert_eq!(y_now, y_after_wait);
+    }
+}
diff --git a/crates/victory-gpu/src/rebar.rs b/crates/victory-gpu/src/rebar.rs
new file mode 100644
index 0000000..644618d
--- /dev/null
+++ b/crates/victory-gpu/src/rebar.rs
@@ -0,0 +1,375 @@
+//! `VICTORY_REBAR` (opt-in, off by default): host copies of title memory in
+//! the card's own memory that the CPU maps (Resizable BAR, D3D12's GPU
+//! upload heap, `D3D12_HEAP_TYPE_GPU_UPLOAD`).
+//!
+//! The console's memory is one: what the CPU writes, the GPU reads where it
+//! lies. Here a host copy of title memory is either in the PC's memory
+//! (`Host::shared_buffer`: the CPU writes it at full speed, every shader
+//! load crosses the bus) or, for big title buffers, in the card's memory
+//! with a second side in the PC's memory and a copy between the two before
+//! each submission (`crate::shadow::cards`). With a large CPU-visible
+//! window on the card's memory the CPU can write the card's side itself:
+//! no PC-side twin, no copy before the submission, shader loads at the
+//! card's speed.
+//!
+//! What is placed there is what the CPU writes and shaders only read:
+//! - `VICTORY_REBAR=1`: windows of title memory outside buffers (the
+//!   title's own allocator: interface vertices, mesh streams, constants;
+//!   run 91: shaders write none of them; run 104: 3.5 GB of the 5.4 GB
+//!   the card shares with the PC).
+//! - `VICTORY_REBAR=2`: also title buffers below the card-buffer size
+//!   (`VICTORY_CARD_BUFFERS_MIN_MB`), which shaders may write. What they
+//!   write is still found and copied back on the CPU, reading the card's
+//!   memory over the bus (uncached: slow), so this level is for A/B tests.
+//!
+//! Never placed there, at any level: the buffers the title reads on the CPU
+//! (its read-back ring, `crate::readback`). The CPU reads those, and a read
+//! of CPU-visible card memory is uncached; they stay in cached PC memory
+//! (write-back custom heap, as before), which is what a read-back heap is.
+//!
+//! Without the heap (Resizable BAR off: a 256 MB BAR; an older driver or
+//! system; the software adapter) nothing changes: every copy is made as
+//! before, and the start line says why.
+//!
+//! `VICTORY_REBAR_MB` sets the most bytes placed (default: a quarter of
+//! the card's budget, at most 4 GiB); as for card buffers, a copy goes
+//! there only while a fifth of the card's budget stays free.
+
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+/// What a copy is.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Kind {
+    /// A window of title memory outside buffers.
+    Window,
+    /// A title buffer's copy (one too small for the card-buffer path).
+    Buffer,
+}
+
+/// Where a copy goes, and why not to the card's mapped memory.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Decision {
+    Rebar,
+    Off,
+    Unsupported,
+    /// The level does not place this kind.
+    NotThisKind,
+    /// The title reads it on the CPU.
+    CpuRead,
+    OverBudget,
+    /// The card's memory is nearly full.
+    CardFull,
+}
+
+/// What a decision is made from.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Ask {
+    pub level: u8,
+    pub supported: bool,
+    pub kind: Kind,
+    pub size: u64,
+    pub cpu_read: bool,
+    /// Bytes already placed, and the most that may be.
+    pub placed: u64,
+    pub most: u64,
+    /// The card's budget and use, if known.
+    pub card: Option<(u64, u64)>,
+}
+
+/// The placement rule (pure: tested below).
+pub(crate) fn decide(ask: &Ask) -> Decision {
+    if ask.level == 0 {
+        return Decision::Off;
+    }
+    if !ask.supported {
+        return Decision::Unsupported;
+    }
+    if ask.cpu_read {
+        return Decision::CpuRead;
+    }
+    match ask.kind {
+        Kind::Window => {}
+        Kind::Buffer if ask.level >= 2 => {}
+        Kind::Buffer => return Decision::NotThisKind,
+    }
+    if ask.placed.saturating_add(ask.size) > ask.most {
+        return Decision::OverBudget;
+    }
+    if let Some((budget, used)) = ask.card
+        && used.saturating_add(ask.size) > budget / 10 * 8
+    {
+        return Decision::CardFull;
+    }
+    Decision::Rebar
+}
+
+/// `VICTORY_REBAR`: 0 (unset, or anything else), 1 or 2.
+pub(crate) fn level_of(value: Option<&str>) -> u8 {
+    match value.map(str::trim) {
+        Some("1") => 1,
+        Some("2") => 2,
+        _ => 0,
+    }
+}
+
+/// The default most bytes: a quarter of the card's budget, at most 4 GiB
+/// (256 MiB when the budget is unknown).
+pub(crate) fn default_most(card_budget: Option<u64>) -> u64 {
+    match card_budget {
+        Some(b) => (b / 4).min(4 << 30),
+        None => 256 << 20,
+    }
+}
+
+pub(crate) fn level() -> u8 {
+    static LEVEL: OnceLock<u8> = OnceLock::new();
+    *LEVEL.get_or_init(|| level_of(std::env::var("VICTORY_REBAR").ok().as_deref()))
+}
+
+/// Whether the host's device has GPU upload heaps: set once at the host's
+/// start ([`probe`]).
+static SUPPORTED: OnceLock<bool> = OnceLock::new();
+
+pub(crate) fn supported() -> bool {
+    SUPPORTED.get().copied().unwrap_or(false)
+}
+
+fn most() -> u64 {
+    static MOST: OnceLock<u64> = OnceLock::new();
+    *MOST.get_or_init(|| {
+        let env = std::env::var("VICTORY_REBAR_MB").ok().and_then(|v| v.trim().parse::<u64>().ok());
+        match env {
+            Some(mb) => mb << 20,
+            None => default_most(crate::host::host().and_then(|h| h.video_memory()).map(|[b, ..]| b)),
+        }
+    })
+}
+
+/// Bytes placed alive, copies placed alive, and copies that wanted to be
+/// placed but were not (over the budget, card full, creation failed).
+static PLACED: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
+/// The next multiple of 64 MiB of placed bytes at which a line is written.
+static NEXT_LINE: AtomicU64 = AtomicU64::new(64 << 20);
+
+/// Reserves bytes against the current count, so concurrent callers cannot
+/// both spend the same remaining budget. Returns the new total.
+fn reserve_bytes(placed: &AtomicU64, size: u64, most: u64) -> Option<u64> {
+    placed
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |used| {
+            used.checked_add(size).filter(|&next| next <= most)
+        })
+        .ok()
+        .map(|before| before + size)
+}
+
+/// At the host's start: whether the device has GPU upload heaps, and the
+/// line that says so.
+pub(crate) fn probe(device: &windows::Win32::Graphics::Direct3D12::ID3D12Device, card_budget: Option<u64>) {
+    use windows::Win32::Graphics::Direct3D12::{D3D12_FEATURE_D3D12_OPTIONS16, D3D12_FEATURE_DATA_D3D12_OPTIONS16};
+    let mut o16 = D3D12_FEATURE_DATA_D3D12_OPTIONS16::default();
+    // SAFETY: a plain query that fills our structure.
+    let asked = unsafe {
+        device.CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS16, (&raw mut o16).cast(), size_of_val(&o16) as u32)
+    };
+    let supported = asked.is_ok() && o16.GPUUploadHeapSupported.as_bool();
+    let _ = SUPPORTED.set(supported);
+    let level = level();
+    let most_mb = match std::env::var("VICTORY_REBAR_MB").ok().and_then(|v| v.trim().parse::<u64>().ok()) {
+        Some(mb) => mb,
+        None => default_most(card_budget) >> 20,
+    };
+    tracing::info!(
+        gpu_upload_heaps = supported,
+        options16_known = asked.is_ok(),
+        card_budget_mb = card_budget.map(|b| b >> 20),
+        level,
+        most_mb,
+        "Resizable BAR (D3D12 GPU upload heaps): {}",
+        match (supported, level) {
+            (true, 0) => "available, not used (VICTORY_REBAR=1 or 2 places host copies there)",
+            (true, 1) => "used for windows of title memory",
+            (true, _) => "used for windows of title memory and small title buffers",
+            (false, 0) => "not available",
+            (false, _) => "NOT available: VICTORY_REBAR is ignored, copies are made as before \
+                           (Resizable BAR off in the firmware/driver, or no OS/driver support)",
+        }
+    );
+}
+
+/// Whether a copy of `size` bytes of `kind` goes to the card's mapped
+/// memory; if it does, its bytes are counted as placed (the caller gives
+/// them back with [`released`] if the buffer cannot be made, or when it
+/// goes).
+pub(crate) fn reserve(kind: Kind, size: u64, cpu_read: bool) -> bool {
+    let level = level();
+    if level == 0 || !supported() {
+        return false;
+    }
+    let host = crate::host::host();
+    let card = host.and_then(|h| h.video_memory()).map(|[b, u, ..]| (b, u));
+    let ask = Ask {
+        level,
+        supported: true,
+        kind,
+        size,
+        cpu_read,
+        placed: PLACED[0].load(Ordering::Relaxed),
+        most: most(),
+        card,
+    };
+    let reserved = match decide(&ask) {
+        Decision::Rebar => reserve_bytes(&PLACED[0], size, ask.most),
+        Decision::OverBudget | Decision::CardFull => None,
+        _ => return false,
+    };
+    let Some(now) = reserved else {
+        if PLACED[2].fetch_add(1, Ordering::Relaxed) == 0 {
+            tracing::warn!(?kind, size, "Resizable BAR: a copy stays in the PC's memory (budget or card full)");
+        }
+        return false;
+    };
+    PLACED[1].fetch_add(1, Ordering::Relaxed);
+    let line = NEXT_LINE.load(Ordering::Relaxed);
+    if now >= line && NEXT_LINE.compare_exchange(line, now / (64 << 20) * (64 << 20) + (64 << 20), Ordering::Relaxed, Ordering::Relaxed).is_ok() {
+        tracing::info!(
+            placed_mb = now >> 20,
+            copies = PLACED[1].load(Ordering::Relaxed),
+            "Resizable BAR: host copies placed in the card's mapped memory"
+        );
+    }
+    true
+}
+
+/// Gives back what [`reserve`] counted.
+pub(crate) fn released(size: u64) {
+    PLACED[0].fetch_sub(size, Ordering::Relaxed);
+    PLACED[1].fetch_sub(1, Ordering::Relaxed);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MIB: u64 = 1 << 20;
+    const GIB: u64 = 1 << 30;
+
+    fn ask(level: u8, kind: Kind) -> Ask {
+        Ask {
+            level,
+            supported: true,
+            kind,
+            size: 4 * MIB,
+            cpu_read: false,
+            placed: 0,
+            most: GIB,
+            card: Some((11 * GIB, 2 * GIB)),
+        }
+    }
+
+    #[test]
+    fn the_switch_reads_only_one_and_two() {
+        assert_eq!(level_of(None), 0);
+        assert_eq!(level_of(Some("0")), 0);
+        assert_eq!(level_of(Some(" 1 ")), 1);
+        assert_eq!(level_of(Some("2")), 2);
+        assert_eq!(level_of(Some("yes")), 0);
+        assert_eq!(level_of(Some("3")), 0);
+    }
+
+    #[test]
+    fn off_or_unsupported_places_nothing() {
+        assert_eq!(decide(&ask(0, Kind::Window)), Decision::Off);
+        let mut a = ask(2, Kind::Window);
+        a.supported = false;
+        assert_eq!(decide(&a), Decision::Unsupported);
+    }
+
+    #[test]
+    fn level_one_places_windows_only_level_two_buffers_too() {
+        assert_eq!(decide(&ask(1, Kind::Window)), Decision::Rebar);
+        assert_eq!(decide(&ask(1, Kind::Buffer)), Decision::NotThisKind);
+        assert_eq!(decide(&ask(2, Kind::Buffer)), Decision::Rebar);
+    }
+
+    #[test]
+    fn cpu_read_buffers_never_go_there() {
+        for level in [1, 2] {
+            for kind in [Kind::Window, Kind::Buffer] {
+                let mut a = ask(level, kind);
+                a.cpu_read = true;
+                assert_eq!(decide(&a), Decision::CpuRead);
+            }
+        }
+    }
+
+    #[test]
+    fn the_budget_holds_to_the_byte() {
+        let mut a = ask(1, Kind::Window);
+        a.placed = GIB - 4 * MIB;
+        assert_eq!(decide(&a), Decision::Rebar);
+        a.placed += 1;
+        assert_eq!(decide(&a), Decision::OverBudget);
+        a.placed = u64::MAX;
+        assert_eq!(decide(&a), Decision::OverBudget);
+    }
+
+    #[test]
+    fn reserved_bytes_stop_at_the_cap_and_can_be_returned() {
+        let placed = AtomicU64::new(4 * MIB);
+        assert_eq!(reserve_bytes(&placed, 4 * MIB, 8 * MIB), Some(8 * MIB));
+        assert_eq!(reserve_bytes(&placed, 1, 8 * MIB), None);
+        assert_eq!(placed.load(Ordering::Relaxed), 8 * MIB);
+        // Allocation failure and teardown return the successful reservation.
+        placed.fetch_sub(4 * MIB, Ordering::Relaxed);
+        assert_eq!(reserve_bytes(&placed, 4 * MIB, 8 * MIB), Some(8 * MIB));
+    }
+
+    #[test]
+    fn reserved_bytes_do_not_wrap() {
+        let placed = AtomicU64::new(u64::MAX - 1);
+        assert_eq!(reserve_bytes(&placed, 2, u64::MAX), None);
+        assert_eq!(placed.load(Ordering::Relaxed), u64::MAX - 1);
+        assert_eq!(reserve_bytes(&placed, 1, u64::MAX), Some(u64::MAX));
+    }
+
+    #[test]
+    fn concurrent_reservations_share_one_budget() {
+        let placed = AtomicU64::new(0);
+        let gate = std::sync::Barrier::new(8);
+        let accepted = std::thread::scope(|scope| {
+            let workers: Vec<_> = (0..8)
+                .map(|_| {
+                    scope.spawn(|| {
+                        gate.wait();
+                        reserve_bytes(&placed, 4 * MIB, 4 * MIB)
+                    })
+                })
+                .collect();
+            workers
+                .into_iter()
+                .filter_map(|worker| worker.join().unwrap())
+                .count()
+        });
+        assert_eq!(accepted, 1);
+        assert_eq!(placed.load(Ordering::Relaxed), 4 * MIB);
+    }
+
+    #[test]
+    fn a_fifth_of_the_card_stays_free() {
+        let mut a = ask(1, Kind::Window);
+        a.card = Some((10 * GIB, 8 * GIB - 4 * MIB));
+        assert_eq!(decide(&a), Decision::Rebar);
+        a.card = Some((10 * GIB, 8 * GIB));
+        assert_eq!(decide(&a), Decision::CardFull);
+        a.card = None;
+        assert_eq!(decide(&a), Decision::Rebar);
+    }
+
+    #[test]
+    fn default_budget_is_a_quarter_of_the_card_at_most_4_gib() {
+        assert_eq!(default_most(None), 256 * MIB);
+        assert_eq!(default_most(Some(11 * GIB)), 11 * GIB / 4);
+        assert_eq!(default_most(Some(30 * GIB)), 4 * GIB);
+    }
+}
diff --git a/crates/victory-gpu/src/regions.rs b/crates/victory-gpu/src/regions.rs
new file mode 100644
index 0000000..b494eaa
--- /dev/null
+++ b/crates/victory-gpu/src/regions.rs
@@ -0,0 +1,541 @@
+//! The title's placeholder memory as the runtime mapped it
+//! ([`victory_core::memmap`]), and the copies of title memory that use it.
+//!
+//! The runtime maps every page the title streams in (`victory-hle` xmem:
+//! placeholders, then views of physical pages) and tells this crate
+//! ([`title_memory_placeholder`], [`crate::title_memory_remapped`],
+//! [`crate::title_memory_view`]). With that record a refresh of a host copy
+//! reads the mapped runs of title memory with plain copies, writes zeros for
+//! the holes, and asks Windows nothing; before it, a read that met a hole
+//! went through the kernel region by region, asking `VirtualQuery` about
+//! each (milliseconds a question in the title's big placeholders): 1-20 s
+//! frames while the title streamed (thousands of mapping changes a frame).
+//! Memory the record does not hold (the title's heaps) is read as before.
+//!
+//! `VICTORY_COPY_FAST=0` copies, guards and asks as before (for A/B).
+
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+use victory_core::memmap::{Kind, RegionMap};
+
+static MAP: Mutex<RegionMap> = Mutex::new(RegionMap::new());
+
+fn map() -> std::sync::MutexGuard<'static, RegionMap> {
+    MAP.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// Whether copies and guards use the record (`VICTORY_COPY_FAST=0`: no).
+pub(crate) fn fast() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var_os("VICTORY_COPY_FAST").is_none_or(|v| v != "0");
+        tracing::info!("title memory copies: {} (VICTORY_COPY_FAST)", if on { "by the runtime's mapping record" } else { "asking Windows, as before" });
+        on
+    })
+}
+
+/// `VICTORY_COPY_NOQUERY=1` (off by default): a chunk whose mapping is
+/// being changed is waited for ([`wait_still`]) and read by the record,
+/// not through the kernel; and the kernel's sparse read
+/// (`host::read_sparse`) takes its runs from the record ([`sparse_runs`]),
+/// asking `VirtualQuery` only about memory it does not know.
+/// With it on the copy-path line is logged at `warn`.
+pub(crate) fn noquery() -> bool {
+    // Live (`victory_core::live`): flipped at frame boundaries by `VICTORY_AB`.
+    static ON: victory_core::live::Switch = victory_core::live::Switch::new("COPY_NOQUERY", 0);
+    static SAID: std::sync::Once = std::sync::Once::new();
+    let on = ON.on();
+    if on {
+        SAID.call_once(|| tracing::warn!("title memory copies: busy chunks waited for, sparse reads by the record (VICTORY_COPY_NOQUERY=1)"));
+    }
+    on
+}
+
+/// The runtime reserved `[at, at + len)` as a placeholder for physical
+/// pages: holes until it maps views there.
+pub fn title_memory_placeholder(at: usize, len: usize) {
+    map().reserve(at, len);
+}
+
+/// The runtime reserved or released `[at, at + len)` as something other than
+/// a placeholder: what the record held there is gone.
+pub fn title_memory_not_placeholder(at: usize, len: usize) {
+    let mut m = map();
+    if !m.is_empty() {
+        m.release(at, len);
+    }
+}
+
+/// `[at, at + len)` shows nothing now (`crate::title_memory_remapped`).
+pub(crate) fn unmapped(at: usize, len: usize) {
+    map().unmap(at, len);
+}
+
+/// `[at, at + len)` shows a view now (`crate::title_memory_view`).
+pub(crate) fn mapped(at: usize, len: usize) {
+    map().map(at, len);
+    prefetch(at, len);
+}
+
+/// Whether every byte of `[at, at + len)` is placeholder memory (mapped or
+/// not): memory that is not write-watched, so a write-watch asking about it
+/// can only fail.
+pub(crate) fn all_placeholder(at: usize, len: usize) -> bool {
+    if !fast() || len == 0 {
+        return false;
+    }
+    let m = map();
+    !m.is_empty() && m.knows_all(at, len)
+}
+
+/// Whether all of `[at, at + len)` is mapped, some of it is a hole, or the
+/// record cannot say (`None`, also with the switch off).
+pub(crate) fn all_mapped(at: usize, len: usize) -> Option<bool> {
+    if !fast() || len == 0 {
+        return None;
+    }
+    let m = map();
+    if m.is_empty() {
+        return None;
+    }
+    let all = m.all_mapped(at, len);
+    // Holes shown through the translation table
+    // (`VICTORY_MEM2_GPU_ONLY_NOVIEW`) count as mapped: they show bytes,
+    // read through the table or in place once made views. (The table is
+    // never asked with the record's lock held: its fault handler takes the
+    // record's lock with the table's held.)
+    let runs = (all == Some(false)).then(|| m.runs(at, len, false));
+    drop(m);
+    if let Some(runs) = runs
+        && crate::translate::any(at, len)
+    {
+        if runs.iter().any(|r| r.kind == Kind::Hole && crate::translate::bytes_in(r.start, r.len()) != r.len()) {
+            return Some(false);
+        }
+        return (!runs.iter().any(|r| r.kind == Kind::Unknown)).then_some(true);
+    }
+    all
+}
+
+/// How many bytes of `[at, at + len)` are mapped, if the record knows all
+/// of it (`None` otherwise, and with the switch off).
+pub(crate) fn mapped_bytes(at: usize, len: usize) -> Option<u64> {
+    if !fast() || len == 0 {
+        return None;
+    }
+    let m = map();
+    if m.is_empty() {
+        return None;
+    }
+    let runs = m.runs(at, len, false);
+    drop(m);
+    let mut bytes = 0u64;
+    for run in runs {
+        match run.kind {
+            Kind::Mapped => bytes += run.len() as u64,
+            // Shown through the translation table: there.
+            Kind::Hole => bytes += crate::translate::bytes_in(run.start, run.len()) as u64,
+            Kind::Unknown => return None,
+        }
+    }
+    Some(bytes)
+}
+
+/// What the record says of `[at, at + len)` for the guards: `None` if it
+/// knows none of it; else its runs, each view on its own.
+pub(crate) fn runs_by_view(at: usize, len: usize) -> Option<Vec<victory_core::memmap::Run>> {
+    if !fast() || len == 0 {
+        return None;
+    }
+    let m = map();
+    if m.is_empty() || !m.knows_any(at, len) {
+        return None;
+    }
+    Some(m.runs(at, len, true))
+}
+
+/// The run holding `at`, by the record (`None` with the switch off).
+pub(crate) fn around(at: usize) -> Option<victory_core::memmap::Run> {
+    if !fast() {
+        return None;
+    }
+    let m = map();
+    if m.is_empty() {
+        return None;
+    }
+    Some(m.around(at))
+}
+
+/// The most read in one piece while the bytes are held still
+/// ([`crate::watch::title_memory_reading_now`]): the title's mapping of
+/// them waits that long at most (some milliseconds).
+const CHUNK: usize = 4 << 20;
+
+/// The longest [`wait_still`] waits: a change takes 10-20 us; one that
+/// waits on a read in place the caller itself holds (a texture refresh
+/// holds `title_memory_reading` around its `copy_mapped`) never ends, so
+/// the wait is bounded and polls (`title_memory_reading_now`) instead of
+/// blocking in `title_memory_reading`: no lock is held while it waits, and
+/// no new lock order is made.
+const WAIT_MOST: std::time::Duration = std::time::Duration::from_millis(2);
+
+/// [`noquery`]: `[at, at + len)` held still once the change of its mapping
+/// under way is done; `None` after [`WAIT_MOST`] (the caller reads through
+/// the kernel, as before).
+fn wait_still(at: usize, len: usize) -> Option<crate::watch::Reading> {
+    let begun = std::time::Instant::now();
+    let mut spins = 0u32;
+    let still = loop {
+        if spins < 64 {
+            std::hint::spin_loop();
+        } else {
+            std::thread::yield_now();
+        }
+        spins += 1;
+        if let Some(r) = crate::watch::title_memory_reading_now(at, len) {
+            break Some(r);
+        }
+        if begun.elapsed() >= WAIT_MOST {
+            break None;
+        }
+    };
+    add(S::WaitUs, begun.elapsed().as_micros() as u64);
+    add(if still.is_some() { S::Waited } else { S::WaitGaveUp }, 1);
+    still
+}
+
+/// [`noquery`]: the record's runs of `[at, at + len)` for the kernel's
+/// sparse read, if it knows any of it (`None`: ask Windows, as before).
+/// Not held still: the runs are a map of where to read, and the read
+/// itself is the kernel's guarded one, as after a `VirtualQuery` (whose
+/// answer was no fresher by the time of the read).
+pub(crate) fn sparse_runs(at: usize, len: usize) -> Option<Vec<victory_core::memmap::Run>> {
+    if !noquery() {
+        return None;
+    }
+    sparse_runs_any(at, len)
+}
+
+/// [`sparse_runs`] whatever the switch.
+pub(crate) fn sparse_runs_any(at: usize, len: usize) -> Option<Vec<victory_core::memmap::Run>> {
+    if !fast() || len == 0 {
+        return None;
+    }
+    let m = map();
+    if m.is_empty() || !m.knows_any(at, len) {
+        return None;
+    }
+    Some(m.runs(at, len, false))
+}
+
+/// Copies title memory `[src, src + len)` into host memory at `dst`: the
+/// mapped runs as they are, zeros for the holes, the rest through `os`
+/// (the kernel's guarded read). False if the record knows nothing of the
+/// range (the caller copies as before).
+pub(crate) fn copy(dst: *mut u8, src: *const u8, len: usize, os: impl Fn(*mut u8, *const u8, usize)) -> bool {
+    copy_by(dst, src, len, os, noquery())
+}
+
+/// [`copy`]; `wait`: busy chunks waited for ([`noquery`]).
+pub(crate) fn copy_by(dst: *mut u8, src: *const u8, len: usize, os: impl Fn(*mut u8, *const u8, usize), wait: bool) -> bool {
+    if len == 0 || !fast() {
+        return false;
+    }
+    let start = src as usize;
+    {
+        let m = map();
+        if m.is_empty() || !m.knows_any(start, len) {
+            return false;
+        }
+    }
+    let begun = std::time::Instant::now();
+    add(S::Copies, 1);
+    for (from, to) in victory_core::memmap::chunks(start, len, CHUNK) {
+        let at = |a: usize| dst.wrapping_add(a - start);
+        // The runtime changes no mapping of these bytes while they are
+        // read (it waits); one under way or waiting: read through the
+        // kernel, which tells a hole from a page itself.
+        // `VICTORY_COPY_NOQUERY=1`: wait for the change (microseconds)
+        // rather than read 4 MiB region by region through the kernel.
+        let still = match crate::watch::title_memory_reading_now(from, to - from) {
+            None if wait => wait_still(from, to - from),
+            still => still,
+        };
+        let Some(_still) = still else {
+            add(S::Busy, 1);
+            os(at(from), from as *const u8, to - from);
+            add(S::OsBytes, (to - from) as u64);
+            continue;
+        };
+        let runs = map().runs(from, to - from, false);
+        for run in runs {
+            add(S::Runs, 1);
+            let n = run.len();
+            match run.kind {
+                Kind::Mapped => {
+                    // SAFETY: the record says these bytes show a mapped,
+                    // committed view (the runtime maps views read-write and
+                    // commits them before telling), and no change of their
+                    // mapping can begin while `_still` is held. The
+                    // destination is the caller's host memory of `len` bytes.
+                    unsafe { std::ptr::copy_nonoverlapping(run.start as *const u8, at(run.start), n) };
+                    add(S::MappedBytes, n as u64);
+                }
+                Kind::Hole if crate::translate::any(run.start, n) => {
+                    // Pages shown through the translation table
+                    // (`VICTORY_MEM2_GPU_ONLY_NOVIEW`): their bytes; the
+                    // rest of the hole as below, piece by piece.
+                    crate::translate::read(run.start, at(run.start), n, |a, d, k| {
+                        add(S::Probes, 1);
+                        let mut byte = [0u8];
+                        if crate::host::read_into(a as *const u8, &mut byte) {
+                            add(S::Stale, 1);
+                            os(d, a as *const u8, k);
+                            add(S::OsBytes, k as u64);
+                        } else {
+                            // SAFETY: inside the caller's host destination.
+                            unsafe { d.write_bytes(0, k) };
+                            add(S::HoleBytes, k as u64);
+                        }
+                        true
+                    });
+                    add(S::MappedBytes, crate::translate::bytes_in(run.start, n) as u64);
+                }
+                Kind::Hole => {
+                    // One look through the kernel at the hole's first byte:
+                    // memory the title reserved anew without the runtime
+                    // (the record keeps placeholders it never saw released)
+                    // reads, and is then read as before and forgotten.
+                    add(S::Probes, 1);
+                    let mut byte = [0u8];
+                    if crate::host::read_into(run.start as *const u8, &mut byte) {
+                        add(S::Stale, 1);
+                        map().release(run.start, n);
+                        os(at(run.start), run.start as *const u8, n);
+                        add(S::OsBytes, n as u64);
+                    } else {
+                        // SAFETY: inside the caller's host destination.
+                        unsafe { at(run.start).write_bytes(0, n) };
+                        add(S::HoleBytes, n as u64);
+                    }
+                }
+                Kind::Unknown => {
+                    os(at(run.start), run.start as *const u8, n);
+                    add(S::OsBytes, n as u64);
+                }
+            }
+        }
+    }
+    add(S::FastUs, begun.elapsed().as_micros() as u64);
+    true
+}
+
+/// Counters of the copy path, since the last stats line.
+#[derive(Clone, Copy)]
+pub(crate) enum S {
+    /// Copies the record handled; runs they were cut into.
+    Copies,
+    Runs,
+    /// Bytes copied plainly from mapped runs, written as zeros for holes,
+    /// and read through the kernel (unknown memory, busy chunks).
+    MappedBytes,
+    HoleBytes,
+    OsBytes,
+    /// Holes looked at through the kernel, and found mapped after all.
+    Probes,
+    Stale,
+    /// Chunks whose mapping was being changed (read through the kernel).
+    Busy,
+    /// Microseconds in copies the record handled.
+    FastUs,
+    /// Copies as before (`host::copy_mapped`), their bytes and microseconds.
+    OsCopies,
+    OsCopyBytes,
+    OsCopyUs,
+    /// System calls by kind: kernel reads, `VirtualQuery`, `VirtualProtect`,
+    /// write-watch askings.
+    Reads,
+    Queries,
+    Protects,
+    Watches,
+    /// Microseconds in `VirtualQuery` and `VirtualProtect` calls.
+    QueryUs,
+    ProtectUs,
+    /// Submission flushes (`host::Batch::flush`), their microseconds, the
+    /// longest, and the page faults the process took during them.
+    Flushes,
+    FlushUs,
+    FlushMaxUs,
+    FlushFaults,
+    /// Write-watch askings left out: the range is all placeholder memory.
+    WatchesSaved,
+    /// Ranges given to the prefetch thread, and their bytes.
+    Prefetched,
+    PrefetchBytes,
+    /// `VICTORY_COPY_NOQUERY`: busy chunks waited for and then read by the
+    /// record, ones given up on ([`WAIT_MOST`]), the microseconds waited;
+    /// `VirtualQuery` calls the sparse read left out (runs the record had).
+    Waited,
+    WaitGaveUp,
+    WaitUs,
+    QueriesSaved,
+}
+
+const COUNTERS: usize = S::QueriesSaved as usize + 1;
+static COUNT: [AtomicU64; COUNTERS] = [const { AtomicU64::new(0) }; COUNTERS];
+
+pub(crate) fn add(s: S, n: u64) {
+    COUNT[s as usize].fetch_add(n, Relaxed);
+}
+
+pub(crate) fn max(s: S, n: u64) {
+    COUNT[s as usize].fetch_max(n, Relaxed);
+}
+
+/// Times a system call of kind `s` (with its microseconds in `us`).
+pub(crate) fn timed<T>(s: S, us: Option<S>, f: impl FnOnce() -> T) -> T {
+    add(s, 1);
+    let Some(us) = us else { return f() };
+    let begun = std::time::Instant::now();
+    let r = f();
+    add(us, begun.elapsed().as_micros() as u64);
+    r
+}
+
+/// The process's page faults so far.
+#[cfg_attr(not(feature = "diagnostics"), allow(dead_code))]
+pub(crate) fn page_faults() -> u64 {
+    use windows_sys::Win32::System::ProcessStatus::{K32GetProcessMemoryInfo, PROCESS_MEMORY_COUNTERS};
+    use windows_sys::Win32::System::Threading::GetCurrentProcess;
+    let mut c = PROCESS_MEMORY_COUNTERS { cb: size_of::<PROCESS_MEMORY_COUNTERS>() as u32, ..Default::default() };
+    // SAFETY: our own process and a sized structure.
+    unsafe { K32GetProcessMemoryInfo(GetCurrentProcess(), &mut c, c.cb) };
+    u64::from(c.PageFaultCount)
+}
+
+/// One line a second at most (called after flushes and at presents, so a
+/// long frame still logs): what the copies did since the last line.
+#[cfg(feature = "diagnostics")]
+pub(crate) fn tick() {
+    static LAST: AtomicU64 = AtomicU64::new(0);
+    let now = crate::host::now_ms();
+    let last = LAST.load(Relaxed);
+    if now < last + 1000 || LAST.compare_exchange(last, now, Relaxed, Relaxed).is_err() {
+        return;
+    }
+    let c: Vec<u64> = COUNT.iter().map(|a| a.swap(0, Relaxed)).collect();
+    let g = |s: S| c[s as usize];
+    let secs = (now - last).max(1) as f64 / 1e3;
+    let mb = |v: u64| v as f64 / 1e6;
+    let ms = |v: u64| v as f64 / 1e3;
+    let copied = g(S::MappedBytes) + g(S::OsCopyBytes);
+    let copy_us = g(S::FastUs) + g(S::OsCopyUs);
+    let regions = {
+        let m = map();
+        m.generation()
+    };
+    let line = format!(
+        "copy path over {secs:.1} s ({}): {} copies by the record in {} runs ({:.1} MB plain, {:.1} MB holes, {:.1} MB through \
+         the kernel; {} holes looked at, {} found mapped; {} chunks busy) {:.1} ms; {} copies as before {:.1} MB {:.1} ms; \
+         {:.0} MB/s; system calls {} (reads {}, queries {} {:.1} ms, protects {} {:.1} ms, write-watch {}, {} left out); \
+         {} flushes {:.1} ms (longest {:.1} ms), {} page faults in them; {} prefetched {:.1} MB; mapping record changes so far {regions}; busy chunks waited {} ({} given up) {:.1} ms, \
+         queries avoided {} (VICTORY_COPY_NOQUERY {})",
+        if fast() { "fast" } else { "as before" },
+        g(S::Copies),
+        g(S::Runs),
+        mb(g(S::MappedBytes)),
+        mb(g(S::HoleBytes)),
+        mb(g(S::OsBytes)),
+        g(S::Probes),
+        g(S::Stale),
+        g(S::Busy),
+        ms(g(S::FastUs)),
+        g(S::OsCopies),
+        mb(g(S::OsCopyBytes)),
+        ms(g(S::OsCopyUs)),
+        if copy_us > 0 { copied as f64 / copy_us as f64 } else { 0.0 },
+        g(S::Reads) + g(S::Queries) + g(S::Protects) + g(S::Watches),
+        g(S::Reads),
+        g(S::Queries),
+        ms(g(S::QueryUs)),
+        g(S::Protects),
+        ms(g(S::ProtectUs)),
+        g(S::Watches),
+        g(S::WatchesSaved),
+        g(S::Flushes),
+        ms(g(S::FlushUs)),
+        ms(g(S::FlushMaxUs)),
+        g(S::FlushFaults),
+        g(S::Prefetched),
+        mb(g(S::PrefetchBytes)),
+        g(S::Waited),
+        g(S::WaitGaveUp),
+        ms(g(S::WaitUs)),
+        g(S::QueriesSaved),
+        if noquery() { "on" } else { "off" },
+    );
+    // Seen at the default `VICTORY_LOG=warn` with the switch on.
+    if noquery() {
+        tracing::warn!(target: "victory_gpu::regions", "{line}");
+    } else {
+        tracing::info!(target: "victory_gpu::regions", "{line}");
+    }
+}
+
+/// Whether views the runtime maps are brought into memory ahead, off the
+/// submitting thread (`VICTORY_COPY_PREFETCH=1`; off by default): if the
+/// stats line shows the copies' time in page faults (memory paged out, or
+/// pages first touched by the copy), the refresh no longer takes them.
+fn prefetching() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_COPY_PREFETCH").is_some_and(|v| v == "1"))
+}
+
+static PREFETCH: Mutex<Vec<(usize, usize)>> = Mutex::new(Vec::new());
+static PREFETCH_READY: std::sync::Condvar = std::sync::Condvar::new();
+
+fn prefetch(at: usize, len: usize) {
+    if !prefetching() || len == 0 {
+        return;
+    }
+    static THREAD: std::sync::Once = std::sync::Once::new();
+    THREAD.call_once(|| {
+        let _ = std::thread::Builder::new().name("victory-prefetch".into()).spawn(prefetch_thread);
+    });
+    let mut q = PREFETCH.lock().unwrap_or_else(|e| e.into_inner());
+    // Pages mapped one by one: one range for the run.
+    if let Some(last) = q.last_mut()
+        && last.0 + last.1 == at
+    {
+        last.1 += len;
+    } else {
+        q.push((at, len));
+    }
+    PREFETCH_READY.notify_one();
+}
+
+fn prefetch_thread() {
+    use windows_sys::Win32::System::Memory::{PrefetchVirtualMemory, WIN32_MEMORY_RANGE_ENTRY};
+    use windows_sys::Win32::System::Threading::GetCurrentProcess;
+    loop {
+        let ranges = {
+            let mut q = PREFETCH.lock().unwrap_or_else(|e| e.into_inner());
+            while q.is_empty() {
+                q = PREFETCH_READY.wait(q).unwrap_or_else(|e| e.into_inner());
+            }
+            std::mem::take(&mut *q)
+        };
+        // A short wait gathers the next pages of a burst into one call.
+        std::thread::sleep(std::time::Duration::from_millis(2));
+        for part in ranges.chunks(512) {
+            let entries: Vec<WIN32_MEMORY_RANGE_ENTRY> =
+                part.iter().map(|&(at, len)| WIN32_MEMORY_RANGE_ENTRY { VirtualAddress: at as *mut _, NumberOfBytes: len }).collect();
+            add(S::Prefetched, part.len() as u64);
+            add(S::PrefetchBytes, part.iter().map(|r| r.1 as u64).sum());
+            // SAFETY: our own process; the call only reads the ranges in
+            // (a range unmapped meanwhile is skipped by the system).
+            unsafe { PrefetchVirtualMemory(GetCurrentProcess(), entries.len(), entries.as_ptr(), 0) };
+        }
+    }
+}
