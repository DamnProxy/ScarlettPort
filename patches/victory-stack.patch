+//! The overlay's font: 5 by 8 pixel glyphs for printable ASCII, in an atlas
+//! of 8 by 8 cells that the renderer uploads once (one byte a texel, 0 or
+//! 255). Cell 95 (after `~`) is solid, so rectangles use the same texture
+//! as text and the whole overlay is one draw.
+//!
+//! The drawing is our own: rows of `#` and `.`, top to bottom, `/` between
+//! rows. A glyph that hangs below the line (`g j p q y`, the comma) uses
+//! the eighth row.
+
+/// Glyph advance and line height at scale 1, in pixels.
+pub const ADVANCE: u32 = 6;
+pub const LINE: u32 = 10;
+/// The atlas: 16 cells across, 6 down, each 8 by 8.
+pub const CELL: u32 = 8;
+pub const ATLAS_W: u32 = 128;
+pub const ATLAS_H: u32 = 48;
+/// The first glyph is the space.
+const FIRST: u32 = 32;
+/// The cell that is all set.
+pub const SOLID_CELL: u32 = 95;
+
+const GLYPHS: [&str; 95] = [
+    // space ! " # $ % & '
+    "...../...../...../...../...../...../...../.....",
+    "..#../..#../..#../..#../..#../...../..#../.....",
+    ".#.#./.#.#./.#.#./...../...../...../...../.....",
+    ".#.#./.#.#./#####/.#.#./#####/.#.#./.#.#./.....",
+    "..#../.####/#.#../.###./..#.#/####./..#../.....",
+    "##..#/##..#/...#./..#../.#.../#..##/#..##/.....",
+    ".##../#..#./#.#../.#.../#.#.#/#..#./.##.#/.....",
+    "..#../..#../.#.../...../...../...../...../.....",
+    // ( ) * + , - . /
