+        assert_eq!((m.slot_of(1), m.slot_of(2)), (None, Some(1)));
+        // A newcomer takes the free slot 0.
+        m.merge(16, [None; 4], &[(2, IDLE), (3, IDLE)]);
+        assert_eq!((m.slot_of(3), m.slot_of(2)), (Some(0), Some(1)));
