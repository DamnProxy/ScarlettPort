+            return;
+        };
+        let Ok(list) = host.new_list() else {
+            return;
+        };
+        let Some((src_buf, src_ptr)) = host.shared_buffer(64 << 10) else {
+            return;
+        };
+        // SAFETY: a mapped host buffer.
+        unsafe { std::ptr::write_bytes(src_ptr, 0x11, 64 << 10) };
+        super::TEST_KEEP.set(Some(true));
