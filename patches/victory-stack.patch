+            op: Some(Op::AddDLo(sh)),
+            src: sl,
+            mask,
+            ident: il,
+            lanes,
+        },
+        Sym::Red {
+            op: Some(Op::AddDHi(sl)),
+            src: sh,
+            mask,
+            ident: ih,
+            lanes,
+        },
+    ))
