+//! `VICTORY_SHADER_OPT` bisection over real programs (ignored; run by hand):
+//! every container in `VICTORY_OPT_BISECT_DIR` (`<hash>.dxbc` files) is
+//! translated with no pass and with each pass bit alone (and every pass), and
+//! both modules run on the CPU (`bitcode::interp`, one lane) against the same
+//! made-up world: inputs, constant buffers and resource reads give numbers
+//! made from their arguments (reads also from how many stores came before),
+//! wave operations from theirs and the discards before. What each run
+//! stores, outputs and discards, in order, must be the same.
+//! Writes `VICTORY_OPT_BISECT_OUT` (a line per program and bit).
+
+use std::io::Write as _;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use super::bitcode::{interp, opt};
+
+fn mix(h: u64, x: u64) -> u64 {
+    let mut z = (h ^ x).wrapping_add(0x9E37_79B9_7F4A_7C15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^ (z >> 31)
+}
+
+fn hash_call(seed: u64, name: &str, args: &[Vec<u64>], extra: u64) -> u64 {
+    let mut h = mix(seed, extra);
+    for b in name.bytes() {
+        h = mix(h, u64::from(b));
+    }
+    for a in args {
+        h = mix(h, 0xA5);
+        for &x in a {
+            h = mix(h, x);
+        }
+    }
+    h
+}
+
+/// The scalars of a made-up result: floats for `.f32`/`.f16`, else integers, some small.
+fn made_up(name: &str, h: u64) -> Vec<u64> {
+    let float = name.ends_with(".f32") || name.ends_with(".f16") || name.ends_with(".f64");
+    let bits = if name.ends_with(".i1") { 1 } else if name.ends_with(".i16") || name.ends_with(".f16") { 16 } else { 32 };
+    (0..8u64)
+        .map(|k| {
+            let r = mix(h, k);
+            if float && bits == 32 {
+                let f: f32 = match r % 8 {
+                    0 => 0.0,
+                    1 => 1.0,
+                    2 => -1.0,
+                    3 => 0.5,
+                    _ => ((r >> 8) % 2001) as f32 / 100.0 - 10.0,
+                };
+                u64::from(f.to_bits())
+            } else if bits == 1 {
+                r & 1
+            } else if r.is_multiple_of(4) {
+                (r >> 8) % 16
+            } else {
+                r & if bits == 16 { 0xFFFF } else { 0xFFFF_FFFF }
+            }
+        })
+        .collect()
+}
+
+/// What a run of `m` does under `seed`: its writes in order, or how it failed.
+fn trace(m: &super::bitcode::Module, seed: u64) -> Result<Vec<String>, String> {
+    trace_observed(m, seed, &mut |_, _| {})
+}
+
+fn trace_observed(m: &super::bitcode::Module, seed: u64, seen: &mut dyn FnMut(u32, &[u64])) -> Result<Vec<String>, String> {
+    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let mut out = Vec::new();
+        let (mut stores, mut discards) = (0u64, 0u64);
+        interp::run_observed(m, &mut |name, a| {
+            let fmt = |a: &[Vec<u64>]| format!("{name} {a:x?}");
+            if name.starts_with("bufferStore")
+                || name.starts_with("rawBufferStore")
+                || name.starts_with("textureStore")
+                || name.starts_with("atomicBinOp")
+                || name.starts_with("atomicCompareExchange")
+                || name == "barrier"
+            {
+                out.push(fmt(a));
+                stores += 1;
+                made_up(name, hash_call(seed, name, a, stores))
+            } else if name.starts_with("store")
+                || name.starts_with("emit")
+                || name.starts_with("cut")
+                || name.starts_with("setMeshOutputCounts")
+            {
+                out.push(fmt(a));
+                vec![]
+            } else if name == "discard" {
+                out.push(fmt(a));
+                discards += 1;
+                vec![]
+            } else if name.starts_with("wave") && name != "waveGetLaneIndex" && name != "waveGetLaneCount"
+                || name.starts_with("quad")
+                || name.starts_with("isHelperLane")
+            {
+                made_up(name, hash_call(seed, name, a, 1 << 40 | discards))
+            } else if name.starts_with("bufferLoad")
+                || name.starts_with("rawBufferLoad")
+                || name.starts_with("textureLoad")
+                || name.starts_with("sample")
+                || name.starts_with("textureGather")
+                || name.starts_with("calculateLOD")
+            {
+                made_up(name, hash_call(seed, name, a, 2 << 40 | stores))
+            } else if name == "binary.i32" && (37..=40).contains(&a[0][0]) {
+                let (x, y) = (a[1][0] as u32, a[2][0] as u32);
+                let r = match a[0][0] {
+                    37 => (x as i32).max(y as i32) as u32,
+                    38 => (x as i32).min(y as i32) as u32,
+                    39 => x.max(y),
+                    _ => x.min(y),
+                };
+                vec![u64::from(r)]
+            } else {
+                made_up(name, hash_call(seed, name, a, 3 << 40))
+            }
+        }, seen);
+        out
+    }));
+    r.map_err(|e| {
+        e.downcast_ref::<String>()
+            .cloned()
+            .or_else(|| e.downcast_ref::<&str>().map(|s| s.to_string()))
+            .unwrap_or_default()
+            .chars()
+            .take(60)
+            .collect()
+    })
+}
+
+thread_local! {
+    static REST: std::cell::RefCell<String> = const { std::cell::RefCell::new(String::new()) };
+}
+
+fn rest() -> String {
+    REST.with(|r| r.borrow().clone())
+}
+
+fn translate_with(bytes: &[u8], bits: u32) -> Option<(String, Vec<u8>, super::bitcode::Module)> {
+    let _ = interp::last();
+    let was = super::TEST_SHADER_OPT.replace(Some(bits));
+    let r = std::panic::catch_unwind(|| super::translate(bytes));
+    super::TEST_SHADER_OPT.set(was);
+    let mut s = r.ok()?.ok()?;
+    let m = interp::last()?;
+    // What besides the code differs: the container's other parts, the rest of the shader.
+    let mut rest = String::new();
+    if let Ok(c) = crate::Container::parse(&s.dxil) {
+        for p in &c.parts {
+            // (the feature flags follow what the passes left: `Usage`)
+            if p.fourcc != crate::FourCC::DXIL && p.fourcc != crate::FourCC(*b"HASH") && p.fourcc != crate::FourCC(*b"SFI0") {
+                rest += &format!("{:?}{:x?}", p.fourcc, p.data);
+            }
+        }
+    }
+    let dxil = std::mem::take(&mut s.dxil);
+    rest += &format!("{s:?}");
+    REST.with(|r| *r.borrow_mut() = rest);
+    Some((format!("{:?}", s.stage), dxil, m))
+}
+
+/// The host facts a run's translations are made with, on this thread:
+/// `VICTORY_OPT_BISECT_WAVE` (the host's widest wave) and
+/// `VICTORY_OPT_BISECT_HEAP` (`limit[,window,slot]`: the view heap's null
+/// slot and its heap map).
+fn host_like() {
+    if let Some(w) = std::env::var("VICTORY_OPT_BISECT_WAVE").ok().and_then(|s| s.parse().ok()) {
+        super::lower::TEST_HOST_WAVE.set(Some(w));
+    }
+    if let Ok(h) = std::env::var("VICTORY_OPT_BISECT_HEAP") {
+        let n: Vec<u32> = h.split(',').filter_map(|s| s.parse().ok()).collect();
+        let map = (n.len() == 3).then(|| (n[1], n[2]));
+        if let Some(&limit) = n.first() {
+            super::shader::TEST_VIEW_HEAP.set(Some((limit, map)));
+        }
+    }
+}
+
+#[test]
+#[ignore]
+fn shader_opt_bisect_over_real_programs() {
+    let dir = std::env::var("VICTORY_OPT_BISECT_DIR").expect("VICTORY_OPT_BISECT_DIR");
+    let outp = std::env::var("VICTORY_OPT_BISECT_OUT").expect("VICTORY_OPT_BISECT_OUT");
+    let only: Vec<String> = std::env::var("VICTORY_OPT_BISECT_STAGES")
+        .unwrap_or_default()
+        .split(',')
+        .filter(|s| !s.is_empty())
+        .map(str::to_owned)
+        .collect();
+    let threads: usize = std::env::var("VICTORY_OPT_BISECT_THREADS").ok().and_then(|s| s.parse().ok()).unwrap_or(16);
+    let mut files: Vec<_> = std::fs::read_dir(&dir).unwrap().filter_map(|e| e.ok().map(|e| e.path())).collect();
+    files.sort();
+    let mut bits: Vec<u32> = (0..11).map(|k| 1u32 << k).collect();
+    bits.push(opt::ALL);
+    let next = AtomicUsize::new(0);
+    let out = Mutex::new(std::fs::File::create(&outp).unwrap());
+    std::thread::scope(|sc| {
+        for _ in 0..threads {
+            sc.spawn(|| {
+                host_like();
+                while let Some(path) = files.get(next.fetch_add(1, Ordering::Relaxed)) {
+                    let name = path.file_stem().unwrap().to_string_lossy().to_string();
+                    let bytes = std::fs::read(path).unwrap();
+                    let mut lines = Vec::new();
+                    let Some((stage, dxil0, m0)) = translate_with(&bytes, 0) else {
+                        continue;
+                    };
+                    let rest0 = rest();
+                    if !only.is_empty() && !only.iter().any(|o| stage.contains(o.as_str())) {
+                        continue;
+                    }
+                    let seeds = [1u64, 2, 3, 4];
+                    let base: Vec<_> = seeds.iter().map(|&s| trace(&m0, s)).collect();
+                    let usable = base.iter().any(|t| t.is_ok());
+                    for &b in &bits {
+                        let t = translate_with(&bytes, b);
+                        let rest_same = rest() == rest0;
+                        let r = match t {
+                            None => "TRANSLATE-ERR".to_string(),
+                            Some((_, d, _)) if d == dxil0 => "same-dxil".to_string(),
+                            Some((_, _, m)) if !usable => {
+                                let _ = m;
+                                format!("changed-unrun({})", base[0].as_ref().err().cloned().unwrap_or_default())
+                            }
+                            Some((_, _, m)) => {
+                                let mut verdict = "same-trace".to_string();
+                                for (k, &s) in seeds.iter().enumerate() {
+                                    let t = trace(&m, s);
+                                    if t != base[k] {
+                                        let first = match (&base[k], &t) {
+                                            (Ok(x), Ok(y)) => {
+                                                let i = x.iter().zip(y).take_while(|(a, b)| a == b).count();
+                                                format!(
+                                                    "at {i}/{}|{}: want {:?} got {:?}",
+                                                    x.len(),
+                                                    y.len(),
+                                                    x.get(i).map(|s| s.chars().take(200).collect::<String>()),
+                                                    y.get(i).map(|s| s.chars().take(200).collect::<String>())
+                                                )
+                                            }
+                                            (x, y) => format!("want {:?} got {:?}", x.as_ref().map(|v| v.len()), y.as_ref().map(|v| v.len())),
+                                        };
+                                        verdict = format!("DIFF seed {s} {first}");
+                                        break;
+                                    }
+                                }
+                                verdict
+                            }
+                        };
+                        let r = if rest_same { r } else { format!("REST {r}") };
+                        lines.push(format!("{name}\t{stage}\t{b}\t{r}"));
+                    }
+                    let mut f = out.lock().unwrap();
+                    for l in lines {
+                        let _ = writeln!(f, "{l}");
+                    }
+                }
+            });
+        }
+    });
+}
+
+/// For `VICTORY_OPT_BISECT_ONE=<file>` and `VICTORY_OPT_BISECT_BITS`, seed
+/// `VICTORY_OPT_BISECT_SEED`: the first instruction (in the optimised run's
+/// order) whose value differs from the same instruction's in the plain run,
+/// with both modules' text around it.
+#[test]
+#[ignore]
+fn shader_opt_bisect_one() {
+    let path = std::env::var("VICTORY_OPT_BISECT_ONE").expect("file");
+    let bits: u32 = std::env::var("VICTORY_OPT_BISECT_BITS").unwrap().parse().unwrap();
+    let seed: u64 = std::env::var("VICTORY_OPT_BISECT_SEED").ok().and_then(|s| s.parse().ok()).unwrap_or(1);
+    let bytes = std::fs::read(path).unwrap();
+    host_like();
+    let (_, _, m0) = translate_with(&bytes, 0).unwrap();
+    let rest0 = rest();
+    let (_, _, m1) = translate_with(&bytes, bits).unwrap();
+    let rest1 = rest();
+    if rest0 != rest1 {
+        let at = rest0.bytes().zip(rest1.bytes()).take_while(|(a, b)| a == b).count();
+        let from = at.saturating_sub(300);
+        println!("rest differs at {at}:
+ plain: {}
+ opt:   {}", &rest0[from..(at + 300).min(rest0.len())], &rest1[from..(at + 300).min(rest1.len())]);
+    }
+    let mut v0 = std::collections::HashMap::new();
+    let _ = trace_observed(&m0, seed, &mut |i, r| {
+        v0.entry(i).or_insert_with(|| r.to_vec());
+    });
+    let mut first = None;
+    let _ = trace_observed(&m1, seed, &mut |i, r| {
+        if first.is_none() && v0.get(&i).is_some_and(|x| x.as_slice() != r) {
+            first = Some((i, v0[&i].clone(), r.to_vec()));
+        }
+    });
+    println!("first differing: {first:x?}");
+    if let Some((i, ..)) = first {
+        println!("--- plain:
+{}", m0.describe_around(i, 12));
+        println!("--- optimised:
+{}", m1.describe_around(i, 12));
+    }
+}
diff --git a/crates/victory-shader/src/emit/opt_tests.rs b/crates/victory-shader/src/emit/opt_tests.rs
new file mode 100644
index 0000000..ff52583
--- /dev/null
+++ b/crates/victory-shader/src/emit/opt_tests.rs
@@ -0,0 +1,329 @@
+//! The lowering's `VICTORY_SHADER_OPT` bits that are not passes over the module
+//! (`opt::MUL24`, `opt::LDSSYNC`, `opt::UNIFORM`): what each leaves out, on synthetic
+//! GFX10 compute programs, lowered with the bit and without. Host-independent (no
+//! validator, no device); `valu_tests` runs the 24-bit forms on WARP.
+
+use std::collections::HashSet;
+
+use super::bitcode::opt;
+use super::lower;
+use crate::native::{
+    ComputeIo, HwStage, NativeProgram, ResourceType, RootParam, RootType, StageIo, UsedResource,
+};
+use crate::{io, ir, resource, structure};
+
+const S_ENDPGM: u32 = 0xBF81_0000;
+
+/// A compute program of `threads` threads (thread index in v0) with 4 root constants in
+/// s0..s3, a raw UAV's descriptor in s[8:11] and `lds_bytes` of LDS, then `body`.
+pub(super) fn native(body: &[u32], wave64: bool, threads: u32, lds_bytes: u32) -> NativeProgram {
+    let mut words = vec![
+        0xBE85_0380, // s_mov_b32 s5, 0
+        0x3D << 26 | 0x02 << 18 | 8 << 6 | 2,
+        125 << 25, // s_load_dwordx4 s[8:11], s[4:5], 0
+    ];
+    words.extend_from_slice(body);
+    words.push(S_ENDPGM);
+    NativeProgram {
+        stage: HwStage::Cs,
+        wave64,
+        vgprs: 16,
+        layout: vec![
+            RootParam {
+                root: RootType::Constants,
+                table_offset_dwords: 0,
+                sgprs: 4,
+                base_register: 0,
+                user_data: 0,
+                slot: 0,
+            },
+            RootParam {
+                root: RootType::Table,
+                table_offset_dwords: 0,
+                sgprs: 1,
+                base_register: 0,
+                user_data: 4,
+                slot: 1,
+            },
+        ],
+        used: vec![UsedResource {
+            kind: ResourceType::Uav,
+            root: RootType::Table,
+            table_offset_dwords: 0,
+            lower_bound: 0,
+            stride: 0,
+            dwords: 4,
+            user_data: 4,
+            slot: 1,
+        }],
+        io: StageIo::Cs(ComputeIo {
+            rsrc2: (5 << 1) | ((lds_bytes / 512) << 15), // 5 user SGPRs: s0..s4
+            threads: [threads, 1, 1],
+        }),
+        code: words.iter().flat_map(|w| w.to_le_bytes()).collect(),
+    }
+}
+
+/// `native` lowered for a host of 32-lane waves with the branches closing `wide` taken
+/// wave-wide, with the lowering's opt bits `bits`.
+pub(super) fn lowered(native: &NativeProgram, wide: &HashSet<usize>, bits: u32) -> lower::Lowered {
+    let p = ir::build(&native.code, native.wave64, native.vgprs).expect("ir::build");
+    let st = structure::structure_wide(&p, wide).expect("structure");
+    let res = resource::track(&p, &native.layout, native.stage, Some(&st)).expect("resource::track");
+    let io = io::raise(&p, native).expect("io::raise");
+    let was_wave = lower::TEST_HOST_WAVE.replace(Some(32));
+    let was_opt = super::TEST_SHADER_OPT.replace(Some(bits));
+    let lowered = lower::lower(&lower::Parts {
+        native,
+        p: &p,
+        st: &st,
+        io: &io,
+        res: &res,
+        inputs: Vec::new(),
+        outputs: Vec::new(),
+        prims: Vec::new(),
+        mesh_stride: 0,
+        dropped: Vec::new(),
+    });
+    lower::TEST_HOST_WAVE.set(was_wave);
+    super::TEST_SHADER_OPT.set(was_opt);
+    lowered.expect("lower")
+}
+
+/// DS `op vdst, addr, data0` (offset 0).
+const fn ds(op: u32, vdst: u32, addr: u32, data0: u32) -> [u32; 2] {
+    [0x36 << 26 | op << 18, vdst << 24 | data0 << 8 | addr]
+}
+const fn ds_write_b32(addr: u32, data: u32) -> [u32; 2] {
+    ds(13, 0, addr, data)
+}
+const fn ds_read_b32(vdst: u32, addr: u32) -> [u32; 2] {
+    ds(54, vdst, addr, 0)
+}
+/// `buffer_store_dword v<vdata>, off, s[8:11], 0`.
+const fn store(vdata: u32) -> [u32; 2] {
+    [0x38 << 26 | 0x1C << 18, 0x80 << 24 | 2 << 16 | vdata << 8]
+}
+/// VOP3 `op vdst, src0, src1, src2` (`src`: 0..105 SGPR, 128.. inline, 256.. VGPR).
+pub(super) const fn vop3(op: u32, vdst: u32, src0: u32, src1: u32, src2: u32) -> [u32; 2] {
+    [0x35 << 26 | op << 16 | vdst, src0 | src1 << 9 | src2 << 18]
+}
+const V: u32 = 256;
+
+/// A console wave64 program of one wave sharing LDS without barriers, run as two host waves
+/// of 32: a write, three reads, a write, a read. Without `LDSSYNC` the halves meet before
+/// each of the six; with it only where an access can see or overwrite what the other half
+/// did since they met: before the first access, the first read, the second write and the
+/// read after it.
+#[test]
+fn lds_meetings_are_left_out_between_reads() {
+    let mut words = vec![0x3402_0082]; // v_lshlrev_b32 v1, 2, v0
+    words.extend(ds_write_b32(1, 0));
+    words.extend(ds_read_b32(2, 1));
+    words.extend(ds_read_b32(3, 1));
+    words.extend(ds_read_b32(4, 1));
+    words.extend(ds_write_b32(1, 2));
+    words.extend(ds_read_b32(5, 1));
+    words.extend(vop3(0x11D, 5, V + 5, V + 3, 0)); // v_xor_b32 v5, v5, v3
+    words.extend(vop3(0x11D, 5, V + 5, V + 4, 0)); // v_xor_b32 v5, v5, v4
+    words.extend(store(5));
+    let native = native(&words, true, 64, 512);
+    let off = lowered(&native, &HashSet::new(), 0);
+    let on = lowered(&native, &HashSet::new(), opt::LDSSYNC);
+    assert_eq!(off.barriers, 6, "one meeting per LDS access");
+    assert_eq!(on.barriers, 4, "no meeting before the second and third read");
+    // the other lowering bits leave this program as it is
+    let rest = lowered(&native, &HashSet::new(), opt::MUL24 | opt::UNIFORM);
+    assert_eq!(rest.dxil, off.dxil);
+}
+
+/// A store to other memory between two LDS reads keeps the meeting before the second.
+#[test]
+fn an_lds_meeting_after_another_store_is_kept() {
+    let mut words = vec![0x3402_0082]; // v_lshlrev_b32 v1, 2, v0
+    words.extend(ds_read_b32(2, 1));
+    words.extend(store(2));
+    words.extend(ds_read_b32(3, 1));
+    words.extend(store(3));
+    let native = native(&words, true, 64, 512);
+    let off = lowered(&native, &HashSet::new(), 0);
+    let on = lowered(&native, &HashSet::new(), opt::LDSSYNC);
+    assert_eq!(off.barriers, 2);
+    assert_eq!(on.barriers, 2);
+}
+
+/// A console wave64 program of one wave in two host waves of 32 that exchange through LDS
+/// (a `v_readlane` makes them): a lane read of a value every lane holds (`v_mov v6, s2`),
+/// and of one each lane holds its own (`v0`). With `UNIFORM` the first needs no exchange.
+#[test]
+fn a_lane_read_of_a_value_every_lane_holds_needs_no_exchange() {
+    let mut words = vec![0x7E0C_0202]; // v_mov_b32 v6, s2
+    words.extend(vop3(0x360, 7, V + 6, 128 + 37, 0)); // v_readlane_b32 s7, v6, 37
+    words.extend(vop3(0x360, 12, V, 128 + 37, 0)); // v_readlane_b32 s12, v0, 37
+    words.push(0x7E00_0207); // v_mov_b32 v0, s7
+    words.push(0x7E02_020C); // v_mov_b32 v1, s12
+    words.extend(vop3(0x11D, 0, V, V + 1, 0)); // v_xor_b32 v0, v0, v1
+    words.extend(store(0));
+    let native = native(&words, true, 64, 0);
+    let off = lowered(&native, &HashSet::new(), 0);
+    let on = lowered(&native, &HashSet::new(), opt::UNIFORM);
+    eprintln!("barriers: {} without UNIFORM, {} with", off.barriers, on.barriers);
+    assert!(off.barriers >= 4, "two exchanges: {}", off.barriers);
+    assert_eq!(on.barriers, off.barriers - 2, "one exchange left");
+}
+
+/// `v_mul_u32_u24` / `v_mad_u32_u24` / `v_mul_hi_u32` on operands known to fit lose their
+/// masks (and the high product its multiply) with `MUL24`; on operands that may not, the
+/// unsigned mask is one `and` and the signed form is as before.
+#[test]
+fn multiplies_of_24_bits_keep_operands_that_fit() {
+    // v1 = s0, v2 = s1 (any value); v3 = v1 >> 16, v4 = v2 >> 16 (16 bits)
+    let mut head = vec![0x7E02_0200, 0x7E04_0201]; // v_mov_b32 v1, s0; v_mov_b32 v2, s1
+    head.extend(vop3(0x116, 3, 128 + 16, V + 1, 0)); // v_lshrrev_b32 v3, 16, v1
+    head.extend(vop3(0x116, 4, 128 + 16, V + 2, 0)); // v_lshrrev_b32 v4, 16, v2
+    let cases: [(&str, [u32; 2], bool); 6] = [
+        ("mul_u24 fits", vop3(0x10B, 0, V + 3, V + 4, 0), true),
+        ("mul_i24 fits", vop3(0x109, 0, V + 3, V + 4, 0), true),
+        ("mad_u24 fits", vop3(0x143, 0, V + 3, V + 4, V + 1), true),
+        ("mul_hi_u32 fits", vop3(0x16A, 0, V + 3, V + 4, 0), true),
+        ("mul_u24 any", vop3(0x10B, 0, V + 1, V + 2, 0), true),
+        ("mul_i24 any", vop3(0x109, 0, V + 1, V + 2, 0), false),
+    ];
+    for (name, inst, smaller) in cases {
+        let mut words = head.clone();
+        words.extend(inst);
+        words.extend(store(0));
+        let native = native(&words, false, 1, 0);
+        let off = lowered(&native, &HashSet::new(), 0);
+        let on = lowered(&native, &HashSet::new(), opt::MUL24);
+        eprintln!("{name}: {} -> {} bytes", off.dxil.len(), on.dxil.len());
+        if smaller {
+            assert!(on.dxil.len() < off.dxil.len(), "{name}: {} -> {}", off.dxil.len(), on.dxil.len());
+        } else {
+            assert_eq!(on.dxil, off.dxil, "{name}");
+        }
+    }
+}
+
+type Model = fn(u32, u32, u32) -> u32;
+
+/// The 24-bit multiplies and high products of `multiplies_of_24_bits_keep_operands_that_fit`
+/// and more, each leaving v0 (stored to dword 0), with the console's result of s0..s2.
+fn multiply_cases() -> Vec<(&'static str, Vec<u32>, Model)> {
+    let sh = |n: u32| 128 + n;
+    let head = |mut w: Vec<u32>| {
+        let mut words = vec![0x7E02_0200, 0x7E04_0201, 0x7E06_0202]; // v1..v3 = s0..s2
+        words.append(&mut w);
+        words.extend(store(0));
+        words
+    };
+    vec![
+        ("mul_u24 any", head(vop3(0x10B, 0, V + 1, V + 2, 0).to_vec()), |a, b, _| {
+            (a & 0xFF_FFFF).wrapping_mul(b & 0xFF_FFFF)
+        }),
+        ("mul_i24 any", head(vop3(0x109, 0, V + 1, V + 2, 0).to_vec()), |a, b, _| {
+            let s = |x: u32| ((x << 8) as i32 >> 8) as u32;
+            s(a).wrapping_mul(s(b))
+        }),
+        (
+            "mul_u24 fits",
+            head([vop3(0x116, 5, sh(16), V + 1, 0), vop3(0x116, 6, sh(8), V + 2, 0), vop3(0x10B, 0, V + 5, V + 6, 0)].concat()),
+            |a, b, _| (a >> 16).wrapping_mul(b >> 8),
+        ),
+        (
+            "mul_i24 fits",
+            head([vop3(0x116, 5, sh(9), V + 1, 0), vop3(0x116, 6, sh(9), V + 2, 0), vop3(0x109, 0, V + 5, V + 6, 0)].concat()),
+            |a, b, _| (a >> 9).wrapping_mul(b >> 9),
+        ),
+        (
+            "mul_i24 one fits",
+            head([vop3(0x116, 5, sh(9), V + 1, 0), vop3(0x109, 0, V + 5, V + 2, 0)].concat()),
+            |a, b, _| (a >> 9).wrapping_mul(((b << 8) as i32 >> 8) as u32),
+        ),
+        (
+            "mul_u24 high bits",
+            head([vop3(0x116, 5, sh(7), V + 1, 0), vop3(0x10B, 0, V + 5, V + 2, 0)].concat()),
+            |a, b, _| ((a >> 7) & 0xFF_FFFF).wrapping_mul(b & 0xFF_FFFF),
+        ),
+        (
+            "mul_hi_u32 zero",
+            head([vop3(0x116, 5, sh(16), V + 1, 0), vop3(0x116, 6, sh(16), V + 2, 0), vop3(0x16A, 0, V + 5, V + 6, 0)].concat()),
+            |a, b, _| ((u64::from(a >> 16) * u64::from(b >> 16)) >> 32) as u32,
+        ),
+        (
+            "mul_hi_u32 not zero",
+            head([vop3(0x116, 5, sh(15), V + 1, 0), vop3(0x116, 6, sh(16), V + 2, 0), vop3(0x16A, 0, V + 5, V + 6, 0)].concat()),
+            |a, b, _| ((u64::from(a >> 15) * u64::from(b >> 16)) >> 32) as u32,
+        ),
+        ("mul_hi_u32 any", head(vop3(0x16A, 0, V + 1, V + 2, 0).to_vec()), |a, b, _| {
+            ((u64::from(a) * u64::from(b)) >> 32) as u32
+        }),
+        (
+            "mul_hi_i32 halves",
+            head([vop3(0x116, 5, sh(1), V + 1, 0), vop3(0x116, 6, sh(1), V + 2, 0), vop3(0x16C, 0, V + 5, V + 6, 0)].concat()),
+            |a, b, _| ((i64::from((a >> 1) as i32) * i64::from((b >> 1) as i32)) >> 32) as u32,
+        ),
+        ("mul_hi_i32 any", head(vop3(0x16C, 0, V + 1, V + 2, 0).to_vec()), |a, b, _| {
+            ((i64::from(a as i32) * i64::from(b as i32)) >> 32) as u32
+        }),
+        ("mad_i24 any", head(vop3(0x142, 0, V + 1, V + 2, V + 3).to_vec()), |a, b, c| {
+            let s = |x: u32| ((x << 8) as i32 >> 8) as u32;
+            s(a).wrapping_mul(s(b)).wrapping_add(c)
+        }),
+        (
+            "mad_u24 fits",
+            head([vop3(0x116, 5, sh(16), V + 1, 0), vop3(0x143, 0, V + 5, V + 2, V + 3)].concat()),
+            |a, b, c| (a >> 16).wrapping_mul(b & 0xFF_FFFF).wrapping_add(c),
+        ),
+    ]
+}
+
+/// Edge operands, then pseudo-random ones (xorshift32).
+fn operand_sets() -> Vec<[u32; 3]> {
+    let edges = [0u32, 1, 0x7F_FFFF, 0x80_0000, 0xFF_FFFF, 0x100_0000, 0x7FFF_FFFF, 0x8000_0000, u32::MAX];
+    let mut sets = Vec::new();
+    for &a in &edges {
+        for &b in &edges {
+            sets.push([a, b, a ^ b ^ 0x1234_5678]);
+        }
+    }
+    let mut x = 0x9E37_79B9u32;
+    let mut next = || {
+        x ^= x << 13;
+        x ^= x >> 17;
+        x ^= x << 5;
+        x
+    };
+    for _ in 0..256 {
+        sets.push([next(), next(), next()]);
+    }
+    sets
+}
+
+/// The differential test of the opt bits on the CPU: each program lowered with no bit,
+/// with `MUL24` alone and with every bit (the module passes too), run over the finished
+/// module ([`super::bitcode::Module::eval`]) on every operand set; all three store the
+/// console's result.
+#[test]
+fn multiplies_with_and_without_the_opt_bits_agree_on_the_cpu() {
+    let sets = operand_sets();
+    for (name, words, model) in multiply_cases() {
+        let native = native(&words, false, 1, 0);
+        for bits in [0, opt::MUL24, opt::ALL] {
+            // the user-data dwords: s0..s3 are dwords 0..3 (the table's address after them)
+            let ins: Vec<Vec<u32>> = sets.iter().map(|s| vec![s[0], s[1], s[2], 0, 0, 0, 0, 0]).collect();
+            super::shader::TEST_EVAL_IN.with(|c| *c.borrow_mut() = ins);
+            let l = lowered(&native, &HashSet::new(), bits);
+            super::shader::TEST_EVAL_IN.with(|c| c.borrow_mut().clear());
+            assert!(l.user_data.iter().all(|u| u.root != RootType::Constants || u.index == u.dword), "{name}");
+            let outs = super::shader::TEST_EVAL_OUT.with(|c| std::mem::take(&mut *c.borrow_mut()));
+            assert_eq!(outs.len(), sets.len());
+            for (s, out) in sets.iter().zip(outs) {
+                let out = out.unwrap_or_else(|| panic!("{name}, opt {bits:#x}: not run on the CPU"));
+                let got = out.iter().rev().find(|(at, _)| *at == 0).map(|x| x.1);
+                assert_eq!(got, Some(model(s[0], s[1], s[2])), "{name}, opt {bits:#x}: {s:x?}");
+            }
+        }
+        eprintln!("{name}: {} operand sets agree with and without the opt bits", sets.len());
+    }
+}
diff --git a/crates/victory-shader/src/emit/per_program.rs b/crates/victory-shader/src/emit/per_program.rs
new file mode 100644
index 0000000..2bbd7fa
--- /dev/null
+++ b/crates/victory-shader/src/emit/per_program.rs
@@ -0,0 +1,195 @@
+//! Switches that pick a translation per program, by the hash a run's log
+//! names the shader by: the first 16 hex digits of the BLAKE3 of the
+//! container as the title passes it (`hash=` in "shader translated" and
+//! "shader does not translate", `#hash` in `victory translate --list`).
+//!
+//! The one so far is for the wave64 form "without skips, scalars followed"
+//! ([`crate::ir::without_skips`] with `deep`), the exact form tried for a
+//! console wave64 compute program on a host of 32-lane waves before the
+//! approximate per-half-wave ones. On an RTX 4080 (2026-11-24) it lost
+//! walls, roofs and floors (about 5,000 draws a frame); off for every
+//! program (`VICTORY_WAVE_DEEP_SKIPS=0`) those came back (about 6,900) and
+//! motion looked wrong. So some of the programs that take it are wrong in
+//! it and others better: it is chosen per program.
+//! - `VICTORY_WAVE_DEEP_SKIPS=0`: off for every program, as before;
+//! - `VICTORY_WAVE_DEEP_SKIPS_NOT=<hash>,...`: off for the listed programs;
+//! - `VICTORY_WAVE_DEEP_SKIPS_ONLY=<hash>,...`: off for every program not
+//!   listed.
+//!
+//! A program's decision is part of its shader cache key (`victory-gpu`'s
+//! `shader_cache`), not the lists: changing a list translates again only
+//! the programs whose decision it changes.
+
+use std::cell::RefCell;
+use std::sync::OnceLock;
+
+use crate::dxbc::Container;
+use crate::native::HwStage;
+
+thread_local! {
+    /// The hash of the container being translated on this thread ([`for_program`]).
+    static PROGRAM: RefCell<Option<String>> = const { RefCell::new(None) };
+}
+
+/// Runs `f`, the translation of the container whose hash is `hash` (see the
+/// module notes): the per-program switches and `VICTORY_WAVE_WHY`'s
+/// `WAVE64-RETRY` lines see it.
+pub fn for_program<T>(hash: &str, f: impl FnOnce() -> T) -> T {
+    struct Restore(Option<String>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            PROGRAM.set(self.0.take());
+        }
+    }
+    let _restore = Restore(PROGRAM.replace(Some(hash.to_owned())));
+    f()
+}
+
+/// The hash [`for_program`] set on this thread, if any.
+pub(super) fn current() -> Option<String> {
+    PROGRAM.with_borrow(Clone::clone)
+}
+
+/// Whether the deep-skips form may be tried for the program whose hash is
+/// `hash` (`None`: not known, as for a translation outside
+/// [`for_program`]), by the switches in the module notes.
+pub fn deep_skips_allowed(hash: Option<&str>) -> bool {
+    struct Switches {
+        on: bool,
+        not: Option<Vec<String>>,
+        only: Option<Vec<String>>,
+    }
+    static SWITCHES: OnceLock<Switches> = OnceLock::new();
+    let s = SWITCHES.get_or_init(|| {
+        let list = |name| std::env::var(name).ok().map(|v| parse_hash_list(&v));
+        Switches {
+            on: std::env::var_os("VICTORY_WAVE_DEEP_SKIPS").is_none_or(|v| v != "0"),
+            not: list("VICTORY_WAVE_DEEP_SKIPS_NOT"),
+            only: list("VICTORY_WAVE_DEEP_SKIPS_ONLY"),
+        }
+    });
+    decide(s.on, s.not.as_deref(), s.only.as_deref(), hash)
+}
+
+/// Whether the wave64 forms, and so the deep-skips switches, can matter for
+/// the program of `container`: a console wave64 compute program, on a host
+/// of 32-lane waves. Cheap (no translation): a superset of the programs
+/// that take the deep-skips form.
+pub fn wave64_retried(container: &[u8]) -> bool {
+    super::lower::host_max_wave() == 32
+        && Container::parse(container)
+            .ok()
+            .and_then(|c| super::main_program(&c).ok())
+            .is_some_and(|p| p.stage == HwStage::Cs && p.wave64)
+}
+
+/// The hashes of a `_NOT` or `_ONLY` list: separated by commas, semicolons
+/// or white space, each with or without the `#` the offline listing puts
+/// before it, in lower case and cut to the 16 digits a hash has. Pure, for
+/// testing.
+fn parse_hash_list(value: &str) -> Vec<String> {
+    value
+        .split(|c: char| c == ',' || c == ';' || c.is_whitespace())
+        .map(|h| h.trim_start_matches('#').to_ascii_lowercase())
+        .map(|h| h.chars().take(16).collect::<String>())
+        .filter(|h| !h.is_empty())
+        .collect()
+}
+
+/// Whether `list` names the program `hash`: an entry names every program
+/// whose hash begins with it.
+fn listed(list: &[String], hash: Option<&str>) -> bool {
+    hash.is_some_and(|hash| {
+        let hash = hash.to_ascii_lowercase();
+        list.iter().any(|entry| hash.starts_with(entry.as_str()))
+    })
+}
+
+/// [`deep_skips_allowed`] on the switches' values. Pure, for testing.
+fn decide(on: bool, not: Option<&[String]>, only: Option<&[String]>, hash: Option<&str>) -> bool {
+    on && !not.is_some_and(|l| listed(l, hash)) && only.is_none_or(|l| listed(l, hash))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const A: &str = "0123456789abcdef";
+    const B: &str = "fedcba9876543210";
+
+    fn list(v: &str) -> Vec<String> {
+        parse_hash_list(v)
+    }
+
+    #[test]
+    fn lists_split_on_commas_and_space_and_take_the_listing_form() {
+        assert_eq!(list(""), Vec::<String>::new());
+        assert_eq!(list(" , ;"), Vec::<String>::new());
+        assert_eq!(list(A), vec![A]);
+        assert_eq!(list(&format!("{A},{B}")), vec![A, B]);
+        assert_eq!(list(&format!(" #{A} ;\t{B} ,")), vec![A, B]);
+        assert_eq!(list("#0123456789ABCDEF"), vec![A], "upper case");
+        // The whole BLAKE3 is cut to the hash a log shows.
+        assert_eq!(list(&format!("{A}{B}{A}{B}")), vec![A]);
+        // A shorter entry stays short: it names every hash that begins with it.
+        assert_eq!(list("01234567"), vec!["01234567"]);
+    }
+
+    #[test]
+    fn without_lists_the_global_switch_decides() {
+        for hash in [Some(A), Some(B), None] {
+            assert!(decide(true, None, None, hash));
+            assert!(!decide(false, None, None, hash));
+        }
+    }
+
+    #[test]
+    fn not_keeps_the_listed_programs_out() {
+        let not = list(&format!("#{B}, 01234567"));
+        assert!(!decide(true, Some(&not), None, Some(A)), "by its first digits");
+        assert!(!decide(true, Some(&not), None, Some(B)));
+        assert!(!decide(true, Some(&not), None, Some(&B.to_ascii_uppercase())));
+        assert!(!decide(true, Some(&not), None, Some("0123456700000000")));
+        assert!(decide(true, Some(&not), None, Some("1111111111111111")));
+        assert!(decide(true, Some(&not), None, None), "an unknown program is not listed");
+        assert!(decide(true, Some(&[]), None, Some(A)), "an empty list keeps everything");
+        assert!(!decide(false, Some(&not), None, Some("1111111111111111")), "=0 still wins");
+    }
+
+    #[test]
+    fn only_lets_just_the_listed_programs_in() {
+        let only = list(A);
+        assert!(decide(true, None, Some(&only), Some(A)));
+        assert!(!decide(true, None, Some(&only), Some(B)));
+        assert!(!decide(true, None, Some(&only), None), "an unknown program is not listed");
+        assert!(!decide(true, None, Some(&[]), Some(A)), "an empty list lets none in");
+        assert!(!decide(false, None, Some(&only), Some(A)), "=0 still wins");
+        // Both: listed in ONLY and not in NOT.
+        let both = list(&format!("{A},{B}"));
+        assert!(!decide(true, Some(&only), Some(&both), Some(A)));
+        assert!(decide(true, Some(&only), Some(&both), Some(B)));
+    }
+
+    #[test]
+    fn the_program_hash_is_seen_inside_its_translation_only() {
+        assert_eq!(current(), None);
+        let inner = for_program(A, || {
+            let nested = for_program(B, current);
+            (current(), nested)
+        });
+        assert_eq!(inner, (Some(A.to_owned()), Some(B.to_owned())));
+        assert_eq!(current(), None);
+        let _ = std::panic::catch_unwind(|| for_program(A, || panic!("a translation that fails")));
+        assert_eq!(current(), None, "restored after a panic too");
+    }
+
+    #[test]
+    fn what_is_no_container_is_not_retried() {
+        for lanes in [0, 32, 64] {
+            let was = super::super::lower::TEST_HOST_WAVE.replace(Some(lanes));
+            assert!(!wave64_retried(b"not a container"), "{lanes}");
+            assert!(!wave64_retried(b"DXBC"), "{lanes}");
+            super::super::lower::TEST_HOST_WAVE.set(was);
+        }
+    }
+}
