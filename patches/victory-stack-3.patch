+    matches!(
+        name,
+        "ds_read_b32"
+            | "ds_read_b64"
+            | "ds_read_b96"
+            | "ds_read_b128"
+            | "ds_read2_b32"
+            | "ds_read2_b64"
+            | "ds_read2st64_b32"
+            | "ds_read2st64_b64"
+    )
+}
