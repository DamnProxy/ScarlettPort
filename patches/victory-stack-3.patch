+# rumble_strength = 1.0     # VICTORY_RUMBLE_STRENGTH, 0 to 2 (levels still stop at full)
+# kbm_hints = "auto"        # VICTORY_KBM_HINTS: "off", "auto" or "always"
+# Upscaling and frame generation (the F1 overlay writes these; the
+# environment wins: VICTORY_UPSCALER, VICTORY_UPSCALE_QUALITY,
+# VICTORY_UPSCALE_SHARPNESS, VICTORY_FRAMEGEN). FSR needs the FidelityFX
+# DLL next to victory.exe (amd_fidelityfx_loader_dx12.dll + its
+# upscaler/framegeneration DLLs, or an MIT-built amd_fidelityfx_dx12.dll).
+#[upscale]
+#upscaler = "fsr"      # fsr | dlss (not wired yet: FSR answers) | title | stretch
+#quality = "quality"   # native | quality | balanced | performance | ultra
+#sharpness = 0.2       # 0..1
+#framegen = false      # FSR 3 frame generation; only use at a base rate of 15 fps or more
diff --git a/xtask/build-ffx-dll.ps1 b/xtask/build-ffx-dll.ps1
new file mode 100644
index 0000000..ba9d182
--- /dev/null
+++ b/xtask/build-ffx-dll.ps1
@@ -0,0 +1,35 @@
+# Builds amd_fidelityfx_dx12.dll (FSR 3.1 upscaler + FSR 3 frame generation)
+# from AMD's MIT-licensed FidelityFX SDK v1.1.4 source, for victory's
+# VICTORY_UPSCALER=fsr and VICTORY_FRAMEGEN=1 (crates/victory-gpu/src/fsr.rs).
+# The DLL is not committed; copy it next to victory.exe.
+#
+#   .\xtask\build-ffx-dll.ps1 -Src <ffx-sdk-source> -Out <target>\release
+#
+# Needs Visual Studio 2022 (C++ desktop, Windows SDK) and CMake. Runs at low
+# priority. The source must be tag v1.1.4 (commit c6efa6bf7f2027b3ec94f28578bb5965eabb9e55):
+#   git clone --depth 1 --branch v1.1.4 https://github.com/GPUOpen-LibrariesAndSDKs/FidelityFX-SDK.git ffx-src
+param(
+    [Parameter(Mandatory)][string]$Src,
+    [Parameter(Mandatory)][string]$Out
+)
+$ErrorActionPreference = 'Stop'
+$commit = git -C $Src rev-parse HEAD
+if ($commit -ne 'c6efa6bf7f2027b3ec94f28578bb5965eabb9e55') { throw "expected FidelityFX SDK v1.1.4, found $commit" }
+$build = Join-Path $Src 'ffx-api\build'
+New-Item -ItemType Directory -Force $build | Out-Null
+$args1 = "-S `"$Src\ffx-api`" -B `"$build`" -G `"Visual Studio 17 2022`" -A x64 -DFFX_API_BACKEND=DX12_X64"
+$args2 = "--build `"$build`" --config Release --parallel 4"
+foreach ($a in @($args1, $args2)) {
+    $p = Start-Process cmake -ArgumentList $a -NoNewWindow -PassThru -Wait:$false
+    $p.PriorityClass = 'BelowNormal'
+    $p.WaitForExit()
+    if ($p.ExitCode -ne 0) { throw "cmake $a failed ($($p.ExitCode))" }
+}
+$dll = Get-ChildItem -Recurse -Path $Src -Filter amd_fidelityfx_dx12.dll |
+    Where-Object { $_.FullName -notmatch 'PrebuiltSignedDLL' } |
+    Sort-Object LastWriteTime -Descending | Select-Object -First 1
+if (-not $dll) { throw 'no amd_fidelityfx_dx12.dll was built' }
+Copy-Item $dll.FullName $Out -Force
+$hash = (Get-FileHash (Join-Path $Out 'amd_fidelityfx_dx12.dll') -Algorithm SHA256).Hash
+Write-Host "built $($dll.FullName)"
+Write-Host "SHA-256 $hash"
diff --git a/xtask/ffx-cross-build.sh b/xtask/ffx-cross-build.sh
new file mode 100644
index 0000000..f968494
--- /dev/null
+++ b/xtask/ffx-cross-build.sh
@@ -0,0 +1,94 @@
+#!/bin/bash
+# Cross-builds amd_fidelityfx_dx12.dll (FSR 3.1 upscaler + FSR 3 frame
+# generation) from AMD's MIT-licensed FidelityFX SDK v1.1.4 for x64 Windows,
+# on Linux: clang-cl / lld-link / llvm-rc and the Windows SDK from
+# cargo-xwin, the SDK's own shader compiler (FidelityFX_SC.exe) under wine.
+# Used on the build farm; xtask/build-ffx-dll.ps1 is the MSVC route.
+#
+#   bash xtask/ffx-cross-build.sh <sdk source copy> <build dir>
+#
+# The source copy is patched in place (Linux and clang-cl only, no change to
+# what is compiled):
+# - the shader rule's output list kept the list's own name as a dependency,
+#   which MSBuild ignores and Ninja refuses;
+# - include paths spelled in another case (FidelityFx/, ffx_FrameInterpolation.h);
+# - warnings as errors off (clang-cl warns where MSVC does not);
+# - the DLL's version resource dropped (it needs MFC's winres.h);
+# - Dwmapi.lib linked as the xwin SDK spells it;
+# - the shader compiler runs under wine with Z: paths.
+set -euo pipefail
+SRC=$1
+B=$2
+X=$HOME/.cache/cargo-xwin/xwin
+TOOLS=$(mktemp -d)
+test "$(cat "$SRC/.ffx-commit" 2>/dev/null || git -C "$SRC" rev-parse HEAD)" = c6efa6bf7f2027b3ec94f28578bb5965eabb9e55
+
+cat > "$TOOLS/ffx-sc" <<W
+#!/usr/bin/env python3
+import os, re, sys, subprocess
+SC = "$SRC/sdk/tools/binary_store/FidelityFX_SC.exe"
+W
+cat >> "$TOOLS/ffx-sc" <<'W'
+def conv(a):
+    return re.sub(r"(^|=|-I |-I)(/[^ ]*)", lambda m: m.group(1) + "Z:" + m.group(2).replace("/", "\\"), a)
+env = dict(os.environ, WINEDEBUG="-all")
+r = subprocess.run(["wine", SC] + [conv(a) for a in sys.argv[1:]], env=env,
+                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
+sys.stdout.write(r.stdout)
+out = next((a.split("=", 1)[1] for a in sys.argv[1:] if a.startswith("-output=")), None)
+if out:
+    for f in os.listdir(out):
+        if f.endswith(".d"):
+            p = os.path.join(out, f)
+            s = open(p, errors="replace").read()
+            t = re.sub(r"[Zz]:\\\\?([^ \n]*)", lambda m: "/" + m.group(1).replace("\\\\", "/").replace("\\", "/"), s)
+            if t != s:
+                open(p, "w").write(t)
+sys.exit(r.returncode)
+W
+chmod +x "$TOOLS/ffx-sc"
+
+python3 - "$SRC" "$TOOLS/ffx-sc" <<'P'
+import sys, os
+src, sc = sys.argv[1], sys.argv[2]
+def edit(rel, a, b):
+    p = os.path.join(src, rel)
+    s = open(p, newline="").read()
+    if b in s:
+        return
+    assert a in s, (rel, a)
+    open(p, "w", newline="").write(s.replace(a, b, 1))
+p = "sdk/include/FidelityFX/gpu/CMakeCompileShaders.txt"
+s = open(os.path.join(src, p), newline="").read()
+nl = "\r\n" if "\r\n" in s else "\n"
+edit(p, "\t#message(STATUS \"OUTPUT_PATH=${OUTPUT_PATH}\")",
+     "\tset(_FFX_OUT_NAME ${PERMUTATION_OUTPUTS})" + nl + "\tset(PERMUTATION_OUTPUTS )" + nl + "\t#message(STATUS \"OUTPUT_PATH=${OUTPUT_PATH}\")")
+edit(p, "\tset(${PERMUTATION_OUTPUTS} ${PERMUTATION_OUTPUTS} PARENT_SCOPE)",
+     "\tset(${_FFX_OUT_NAME} ${PERMUTATION_OUTPUTS} PARENT_SCOPE)")
+for rel in ["sdk/src/backends/dx12/CMakeLists.txt", "sdk/src/components/fsr1/CMakeLists.txt", "sdk/src/components/fsr2/CMakeLists.txt"]:
+    q = os.path.join(src, rel)
+    t = open(q, newline="").read()
+    open(q, "w", newline="").write(t.replace('"/WX"', '""'))
+q = os.path.join(src, "sdk/CMakeLists.txt")
+t = open(q, newline="").read()
+import re
+t = re.sub(r"set\(FFX_SC_EXECUTABLE [^)]*\)", "set(FFX_SC_EXECUTABLE " + sc + ")", t)
+open(q, "w", newline="").write(t)
+open(os.path.join(src, "ffx-api/src/resource/ffx_api_dll.rc"), "w").write("// version resource dropped for the cross build\n")
+P
+# A `#pragma comment(lib, "Dwmapi.lib")`; the xwin SDK names it in lower case.
+ln -sf dwmapi.lib "$X/sdk/lib/um/x86_64/Dwmapi.lib"
+ln -sfn FidelityFX "$SRC/sdk/include/FidelityFx"
+ln -sf ffx_frameinterpolation.h "$SRC/sdk/include/FidelityFX/host/ffx_FrameInterpolation.h"
+
